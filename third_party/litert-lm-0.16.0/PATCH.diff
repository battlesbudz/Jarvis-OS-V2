+  @JvmStatic external fun nativeSeal(handle: Long, utterance: String, generation: Long): NativeAudioSealWire
+  @JvmStatic external fun nativeRequestCancel(handle: Long): Boolean
+  @JvmStatic external fun nativeDrain(handle: Long, timeoutMillis: Long): Boolean
+  @JvmStatic external fun nativeClose(handle: Long, timeoutMillis: Long): Boolean
+}
