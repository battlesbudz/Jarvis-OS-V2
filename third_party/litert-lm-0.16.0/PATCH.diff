+package com.google.ai.edge.litertlm
+
+/** Calibration never establishes this contract. Keep UNVERIFIED until a reviewed
+ * source/platform contract establishes System.nanoTime and native CLOCK_MONOTONIC
+ * have the same rate through the measured interval. See CLOCK-CONTRACT.md.
+ */
+enum class NativeClockContract(val verified: Boolean) {
+  UNVERIFIED(false), REVIEWED_AOSP_ANDROID_API30_36(true);
+
+  /** Source-level compatibility only, not OEM binary attestation. Host, unknown
+   * VM and unsupported Android API levels remain unverified without override.
+   */
+  fun forCurrentPlatform(): NativeClockContract {
+    if (this == UNVERIFIED) return UNVERIFIED
+    return try {
+      if (System.getProperty("java.vm.name") != "Dalvik") return UNVERIFIED
+      val version = Class.forName("android.os.Build\$VERSION")
+      val api = version.getField("SDK_INT").getInt(null)
+      if (api in 30..36) this else UNVERIFIED
+    } catch (_: ReflectiveOperationException) { UNVERIFIED }
+      catch (_: SecurityException) { UNVERIFIED }
+      catch (_: LinkageError) { UNVERIFIED }
+  }
+}
+enum class NativeAudioTimingPhase { OPEN, SEALED, CANCELLED, FAILED, CLOSED }
+enum class NativeWorkBeforeKind { UNAVAILABLE, NO_COMPLETED, ALL_BEFORE, AT_LEAST_ONE, AMBIGUOUS }
+
+/** Conservative closed integer-nanosecond bounds in the Java nanoTime domain.
+ * A relative interval belongs to its explicitly supplied origin; do not mix domains.
+ */
+data class NativeNanoInterval(val lowerNanos: Long, val upperNanos: Long) {
+  init { require(lowerNanos <= upperNanos) }
+  fun relativeTo(originNanos: Long): NativeNanoInterval? = checked {
+    NativeNanoInterval(Math.subtractExact(lowerNanos, originNanos), Math.subtractExact(upperNanos, originNanos))
+  }
+  fun elapsedTo(end: NativeNanoInterval): NativeNanoInterval? = checked {
+    NativeNanoInterval(Math.subtractExact(end.lowerNanos, upperNanos), Math.subtractExact(end.upperNanos, lowerNanos))
+  }
+  companion object {
+    fun point(nanos: Long) = NativeNanoInterval(nanos, nanos)
+    fun fromFlooredMillis(millis: Long): NativeNanoInterval? = checked {
+      val lower = Math.multiplyExact(millis, 1_000_000L)
+      NativeNanoInterval(lower, Math.addExact(lower, 999_999L))
+    }
+  }
+}
+private inline fun <T> checked(action: () -> T): T? = try { action() } catch (_: ArithmeticException) { null }
+
+data class NativeWorkBefore(
+  val kind: NativeWorkBeforeKind,
+  val stepLowerBound: Int,
+  val stepUpperBound: Int,
+  val exactStepCount: Int?,
+  val exactRowCount: Int?,
+)
+
+/** Fixed immutable diagnostic metadata. It does not authorize a turn or an effect.
+ * No raw native clock, calibration offset, audio, transcript, hash or activation
+ * array is exposed. App publication still requires candidate/generation + close.
+ */
+// Publicly constructible for cross-module consumers/tests. This is observation
+// data, never proof of native execution or authentication of Content/admission.
+class NativeAudioTimingReceipt(
+  val phase: NativeAudioTimingPhase,
+  val producerInstance: Long,
+  val acceptedPcmSamples: Int,
+  val completedSteps: Int,
+  val validatedAudioRows: Int,
+  val nativeTimingValid: Boolean,
+  val verifiedClockContract: Boolean,
+  val mappingAvailable: Boolean,
+  val firstAccepted: NativeNanoInterval?,
+  val firstStep: NativeNanoInterval?,
+  val lastStep: NativeNanoInterval?,
+  val sealCommit: NativeNanoInterval?,
+  val alignmentUncertaintyNanos: Long?,
+) {
+  init {
+    require(producerInstance > 0 && acceptedPcmSamples in 0..480000)
+    require(completedSteps in 0..750 && validatedAudioRows in 0..750)
+    val maxRows = if (acceptedPcmSamples == 0) 0 else (maxOf(1, acceptedPcmSamples / 160) + 3) / 4
+    require(completedSteps <= validatedAudioRows && validatedAudioRows <= completedSteps * 12 && validatedAudioRows <= maxRows)
+    require((completedSteps == 0) == (validatedAudioRows == 0))
+    if (phase == NativeAudioTimingPhase.SEALED) require(acceptedPcmSamples > 0 && completedSteps > 0 && validatedAudioRows == maxRows)
+    val intervals = listOfNotNull(firstAccepted, firstStep, lastStep, sealCommit)
+    if (!mappingAvailable) require(intervals.isEmpty() && alignmentUncertaintyNanos == null)
+    else {
+      require(nativeTimingValid && verifiedClockContract && alignmentUncertaintyNanos != null && alignmentUncertaintyNanos >= 0)
+      require((acceptedPcmSamples == 0) == (firstAccepted == null))
+      require((completedSteps == 0) == (firstStep == null) && (completedSteps == 0) == (lastStep == null))
+      if (phase == NativeAudioTimingPhase.SEALED) require(sealCommit != null)
+      if (phase == NativeAudioTimingPhase.OPEN) require(sealCommit == null)
+      var prior: NativeNanoInterval? = null
+      for (interval in intervals) {
+        val width = checked { Math.subtractExact(interval.upperNanos, interval.lowerNanos) }
+        require(width != null && width / 2 + width % 2 <= alignmentUncertaintyNanos)
+        prior?.let { require(interval.lowerNanos >= it.lowerNanos && interval.upperNanos >= it.upperNanos) }
+        prior = interval
+      }
+    }
+  }
+
+  fun isBoundTo(provenance: NativeAudioProvenance): Boolean =
+    phase == NativeAudioTimingPhase.SEALED && producerInstance == provenance.producerInstance &&
+      acceptedPcmSamples == provenance.pcmSampleCount && validatedAudioRows == provenance.audioTokenCount
+
+  /** Counts measured validated-step commits, never merely launched/partial graph work. */
+  fun workBefore(cutoff: NativeNanoInterval): NativeWorkBefore {
+    if (phase != NativeAudioTimingPhase.SEALED || !mappingAvailable || !nativeTimingValid)
+      return NativeWorkBefore(NativeWorkBeforeKind.UNAVAILABLE, 0, completedSteps, null, null)
+    if (completedSteps == 0)
+      return NativeWorkBefore(NativeWorkBeforeKind.NO_COMPLETED, 0, 0, 0, 0)
+    val first = firstStep ?: return NativeWorkBefore(NativeWorkBeforeKind.UNAVAILABLE, 0, completedSteps, null, null)
+    val last = lastStep ?: return NativeWorkBefore(NativeWorkBeforeKind.UNAVAILABLE, 0, completedSteps, null, null)
+    if (last.upperNanos < cutoff.lowerNanos)
+      return NativeWorkBefore(NativeWorkBeforeKind.ALL_BEFORE, completedSteps, completedSteps, completedSteps, validatedAudioRows)
+    if (first.lowerNanos >= cutoff.upperNanos)
+      return NativeWorkBefore(NativeWorkBeforeKind.NO_COMPLETED, 0, 0, 0, 0)
+    if (first.upperNanos < cutoff.lowerNanos)
+      return NativeWorkBefore(NativeWorkBeforeKind.AT_LEAST_ONE, 1, completedSteps, null, null)
+    return NativeWorkBefore(NativeWorkBeforeKind.AMBIGUOUS, 0, completedSteps, null, null)
+  }
+}
+
+/** Strict transport parsing, kept internal so raw clocks do not become export API. */
+internal class NativeTimingWords private constructor(
+  val phase: NativeAudioTimingPhase, val producer: Long, val flags: Long,
+  val sampled: Long, val accepted: Long, val pcm: Int, val steps: Int, val rows: Int,
+  val first: Long, val last: Long, val sealed: Long,
+) {
+  val clockValid: Boolean get() = flags == 1L
+  companion object {
+    fun parse(words: LongArray): NativeTimingWords {
+      check(words.size == 12 && words[0] == 1L) { "Native timing-v1 receipt required" }
+      check(words[1] in 0L..4L && words[2] > 0L && words[3] in setOf(1L, 2L, 4L, 6L)) {
+        "Invalid native timing phase/instance/flags"
+      }
+      val phase = NativeAudioTimingPhase.entries[words[1].toInt()]
+      check(words[6] in 0L..480000L && words[7] in 0L..750L && words[8] in 0L..750L)
+      val pcm = words[6].toInt(); val steps = words[7].toInt(); val rows = words[8].toInt()
+      val maxRows = if (pcm == 0) 0 else (maxOf(1, pcm / 160) + 3) / 4
+      check(steps <= rows && rows <= steps * 12 && rows <= maxRows) { "Invalid timing counts" }
+      check((steps == 0) == (rows == 0))
+      for (index in intArrayOf(4,5,9,10,11)) check(words[index] >= -1L)
+      if (pcm == 0) check(words[5] == -1L && steps == 0)
+      if (steps == 0) check(words[9] == -1L && words[10] == -1L)
+      if (phase == NativeAudioTimingPhase.OPEN) check(words[11] == -1L)
+      if (phase == NativeAudioTimingPhase.SEALED) check(pcm > 0 && steps > 0 && rows == maxRows)
+      if (words[3] == 1L) {
+        check(words[4] >= 0)
+        if (pcm > 0) check(words[5] in 0L..words[4])
+        if (steps > 0) check(words[9] >= words[5] && words[9] >= 0 && words[10] in words[9]..words[4])
+        if (words[11] >= 0) check(words[11] in maxOf(0L, words[10])..words[4])
+        if (phase == NativeAudioTimingPhase.SEALED) check(words[11] >= 0)
+      }
+      return NativeTimingWords(phase, words[2], words[3], words[4], words[5], pcm, steps, rows,
+        words[9], words[10], words[11])
+    }
+  }
+}
+
+/** Constant-memory alignment: <=3 startup brackets + <=2 snapshot brackets.
+ * A valid fit is insufficient without an explicit verified clock contract.
+ */
+internal class NativeClockAlignment private constructor(private val contract: NativeClockContract) {
+  private var low: Long? = null
+  private var high: Long? = null
+  private var lastJavaEnd: Long? = null
+  private var lastNative: Long? = null
+  private var invalid = false
+  private var snapshots = 0
+  val canSnapshot: Boolean get() = snapshots < 2
+  private fun sample(before: Long, native: Long, after: Long) {
+    if (invalid) return
+    if (native < 0 || after < before || lastJavaEnd?.let { before < it } == true ||
+        lastNative?.let { native < it } == true) { invalid = true; return }
+    val nextLow = checked { Math.subtractExact(before, native) }
+    val nextHigh = checked { Math.subtractExact(after, native) }
+    if (nextLow == null || nextHigh == null) { invalid = true; return }
+    val lower = low?.let { maxOf(it, nextLow) } ?: nextLow
+    val upper = high?.let { minOf(it, nextHigh) } ?: nextHigh
+    if (lower > upper || checked { Math.subtractExact(upper, lower) } == null) { invalid = true; return }
+    low = lower; high = upper; lastJavaEnd = after; lastNative = native
+  }
+
+  fun snapshot(before: Long, words: LongArray, after: Long): NativeAudioTimingReceipt? {
+    if (snapshots >= 2) return null
+    snapshots++
+    val value = NativeTimingWords.parse(words)
+    sample(before, value.sampled, after)
+    var usable = !invalid && value.clockValid && contract.verified && low != null && high != null
+    fun mapped(stamp: Long): NativeNanoInterval? {
+      if (!usable || stamp < 0) return null
+      val result = checked { NativeNanoInterval(Math.addExact(stamp, low!!), Math.addExact(stamp, high!!)) }
+      if (result == null) usable = false
+      return result
+    }
+    val accepted = mapped(value.accepted); val first = mapped(value.first)
+    val last = mapped(value.last); val sealed = mapped(value.sealed)
+    val width = if (usable) checked { Math.subtractExact(high!!, low!!) } else null
+    val uncertainty = width?.let { it / 2 + it % 2 }
+    if (uncertainty == null) usable = false
+    return NativeAudioTimingReceipt(value.phase, value.producer, value.pcm, value.steps, value.rows,
+      value.clockValid, contract.verified, usable,
+      accepted.takeIf { usable }, first.takeIf { usable }, last.takeIf { usable }, sealed.takeIf { usable },
+      uncertainty.takeIf { usable })
+  }
+
+  companion object {
+    /** Must run before nativeCreate/global references. Missing old-ABI symbol is fatal. */
+    fun preflight(contract: NativeClockContract, handshake: () -> LongArray,
+      javaNow: () -> Long = System::nanoTime): NativeClockAlignment {
+      val result = NativeClockAlignment(contract)
+      repeat(3) {
+        val before = javaNow()
+        val words = try { handshake() } catch (error: UnsatisfiedLinkError) {
+          throw IllegalStateException("Native timing-v1 ABI required before owner creation", error)
+        }
+        val after = javaNow()
+        try {
+          check(words.size == 3 && words[0] == 1L && words[1] == 1L && words[2] >= 0L) {
+            "Native timing-v1 CLOCK_MONOTONIC handshake required"
+          }
+          result.sample(before, words[2], after)
+        } finally { words.fill(0L) }
+      }
+      return result
+    }
+  }
+}
