+bool HasExactString(const nlohmann::ordered_json& object, const char* key,
+                    const char* expected) {
+  return object.contains(key) && object[key].is_string() &&
+         object[key].get_ref<const std::string&>() == expected;
+}
+
+bool HasBoundedInteger(const nlohmann::ordered_json& object, const char* key,
+                       int64_t maximum) {
+  return object.contains(key) && object[key].is_number_integer() &&
+         object[key] > 0 && object[key] <= maximum;
+}
+
+absl::StatusOr<SealedProjectedAudioSpec> ParseProjectedAudioSpec(
+    const nlohmann::ordered_json& item) {
+  const auto& metadata = item["projected_audio"];
+  if (!metadata.is_object() ||
+      !HasBoundedInteger(metadata, "schema_version", 1) ||
+      !HasExactString(metadata, "dtype", "float32_le") ||
+      !HasExactString(metadata, "projection", "audio_adapter") ||
+      !HasExactString(metadata, "end_marker", "runtime") ||
+      !metadata.contains("complete") || !metadata["complete"].is_boolean() ||
+      !HasBoundedInteger(metadata, "pcm_samples", 480000) ||
+      !HasBoundedInteger(metadata, "token_count", 750) ||
+      !HasBoundedInteger(metadata, "embedding_width", 8192) ||
+      !metadata.contains("seal_token") || !metadata["seal_token"].is_string() ||
+      !metadata.contains("producer_sha256") ||
+      !metadata["producer_sha256"].is_string() || item.contains("path") ||
+      !item.contains("blob") || !item["blob"].is_string()) {
+    return absl::InvalidArgumentError("Malformed sealed projected-audio payload.");
+  }
+  SealedProjectedAudioSpec spec{
+      .pcm_samples = metadata["pcm_samples"].get<int64_t>(),
+      .audio_tokens = metadata["token_count"].get<int64_t>(),
+      .embedding_width = metadata["embedding_width"].get<int64_t>(),
+      .seal_token = metadata["seal_token"].get<std::string>(),
+      .producer_sha256 = metadata["producer_sha256"].get<std::string>(),
+      .complete = metadata["complete"].get<bool>(),
+  };
+  const auto error = ::litert::support::ValidateSealedProjectedAudio(spec);
+  if (error != ProjectedAudioError::kOk) {
+    return absl::InvalidArgumentError(
+        ::litert::support::ProjectedAudioErrorMessage(error));
+  }
+  if (item["blob"].get_ref<const std::string&>().size() !=
+      ::litert::support::ProjectedAudioBase64Count(spec)) {
+    return absl::InvalidArgumentError(
+        "Projected audio base64 size does not match its bounded shape.");
+  }
+  return spec;
+}
+
+absl::StatusOr<InputAudio> MakeProjectedAudioInput(const AudioSource& source) {
+  std::vector<float> values;
+  const auto& spec = *source.projected;
+  const auto error = ::litert::support::DecodeProjectedAudio(
+      spec, std::string_view(static_cast<const char*>(source.file->data()),
+                             source.file->length()), &values);
+  if (error != ProjectedAudioError::kOk) {
+    return absl::InvalidArgumentError(
+        ::litert::support::ProjectedAudioErrorMessage(error));
+  }
+  LITERT_ASSIGN_OR_RETURN(
+      auto tensor, ::litert::support::CreateTensorBuffer<float>(
+                       ::litert::Dimensions({1, static_cast<int>(spec.audio_tokens),
+                                              static_cast<int>(spec.embedding_width)})));
+  LITERT_RETURN_IF_ERROR(tensor.Write<float>(absl::MakeConstSpan(values)));
+  InputAudio input(std::move(tensor), /*is_embeddings=*/true);
+  ABSL_RETURN_IF_ERROR(input.ValidateAudioEmbeddings());
+  return input;
+}
+}  // namespace
