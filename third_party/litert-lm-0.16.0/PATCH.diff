+bool ContainsProjectedAudioPayload(const nlohmann::ordered_json& messages) {
+  const auto contains_in_message = [](const nlohmann::ordered_json& message) {
+    if (!message.is_object() || !message.contains("content") ||
+        !message["content"].is_array()) {
+      return false;
+    }
+    for (const auto& item : message["content"]) {
+      if (item.is_object() && item.contains("type") &&
+          item["type"] == "audio" && item.contains("projected_audio")) {
+        return true;
+      }
+    }
+    return false;
+  };
+  if (!messages.is_array()) return contains_in_message(messages);
+  for (const auto& message : messages) {
+    if (contains_in_message(message)) return true;
+  }
+  return false;
+}
