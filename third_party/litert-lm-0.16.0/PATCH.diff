diff --git a/experimental/native_audio_owner_jni_20261006/NativeAudioOwner.kt b/experimental/native_audio_owner_jni_20261006/NativeAudioOwner.kt
new file mode 100644
index 0000000..8ffaa6a
--- /dev/null
+++ b/experimental/native_audio_owner_jni_20261006/NativeAudioOwner.kt
@@ -0,0 +1,236 @@
+package com.google.ai.edge.litertlm
+
+import java.io.File
+import java.security.MessageDigest
+import java.util.concurrent.atomic.AtomicLong
+
+/** Application-owned contract, not authentication supplied by a path/hash string.
+ * While this object is retained, immutablePath must keep naming the exact verified
+ * immutable bytes. The app's artifact manager must forbid replacement, mutation,
+ * premature release and conflicting leases. A GlobalRef alone cannot enforce that.
+ */
+interface NativeAudioArtifactLease {
+  val immutablePath: String
+  fun checkImmutableAndLive()
+}
+
+/** Bind on a dedicated application worker. The platform policy must reject UI and
+ * capture callback threads (e.g. Android Looper + the actual capture-thread identity).
+ * All synchronous operations stay on this exact worker; requestCancel is thread-safe.
+ */
+class NativeAudioWorker private constructor(
+  private val worker: Thread,
+  private val checkNotUiOrCapture: () -> Unit,
+) {
+  internal fun check() {
+    check(Thread.currentThread() === worker) { "Use the bound native audio worker" }
+    checkNotUiOrCapture()
+    callbackGuard.checkCanBlock()
+  }
+  companion object {
+    private val callbackGuard = ConversationReuseGuard()
+    fun bindCurrentThread(checkNotUiOrCapture: () -> Unit): NativeAudioWorker =
+      NativeAudioWorker(Thread.currentThread(), checkNotUiOrCapture).also { it.check() }
+  }
+}
+
+data class NativeAudioIdentity(val utteranceId: String, val generation: Long) {
+  init {
+    require(generation > 0 && utteranceId.length in 1..64 && utteranceId.all {
+      it in 'a'..'z' || it in 'A'..'Z' || it in '0'..'9' || it == '_' || it == '-'
+    }) { "Bounded utterance identity and positive generation required" }
+  }
+}
+
+data class NativeAudioProvenance(
+  val identity: NativeAudioIdentity,
+  val producerInstance: Long,
+  val producerSha256: String,
+  val pcmSampleCount: Int,
+  val melFrameCount: Int,
+  val audioTokenCount: Int,
+  val droppedTailSamples: Int,
+  val paddedTinySamples: Int,
+)
+
+/** Contains immutable Content bytes; exposes no provisional/mutable token rows. */
+class CompletedNativeAudio internal constructor(
+  val content: Content.SealedAudioEmbeddings,
+  val provenance: NativeAudioProvenance,
+  val timing: NativeAudioTimingReceipt?,
+)
+
+class NativeAudioOwner private constructor(
+  handle: Long,
+  private val worker: NativeAudioWorker,
+  val identity: NativeAudioIdentity,
+  private val maxPacketSamples: Int,
+  artifact: NativeAudioArtifactLease,
+  private val clockAlignment: NativeClockAlignment,
+) {
+  private val nativeHandle = AtomicLong(handle)
+  @Volatile private var artifactLease: NativeAudioArtifactLease? = artifact
+  val isClosed: Boolean get() = nativeHandle.get() == 0L
+
+  private fun handle(): Long = nativeHandle.get().also { check(it != 0L) { "Owner closed" } }
+
+  /** No queuing and no implicit packet padding; PCM is copied into bounded native
+   * storage before inference. Do not modify pcm during this synchronous call.
+   */
+  fun appendOnWorker(pcm: FloatArray, suppliedIdentity: NativeAudioIdentity = identity) {
+    worker.check()
+    require(pcm.size <= maxPacketSamples) { "Packet sample budget exceeded" }
+    NativeAudioOwnerJni.nativeAppend(handle(), pcm, suppliedIdentity.utteranceId,
+      suppliedIdentity.generation)
+  }
+
+  fun sealOnWorker(suppliedIdentity: NativeAudioIdentity = identity): CompletedNativeAudio {
+    worker.check()
+    val wire = NativeAudioOwnerJni.nativeSeal(handle(), suppliedIdentity.utteranceId,
+      suppliedIdentity.generation)
+    try {
+      check(wire.utteranceId == identity.utteranceId && wire.generation == identity.generation)
+      check(wire.producerSha256 == PINNED_SHA256 && wire.producerInstance > 0)
+      check(wire.pcmSamples in 1..480000)
+      val mel = maxOf(1, wire.pcmSamples / 160)
+      check(wire.melFrames == mel && wire.tokens == (mel + 3) / 4)
+      check(wire.rows.size == wire.tokens * 1536)
+      check(wire.droppedTail == if (wire.pcmSamples >= 160) wire.pcmSamples % 160 else 0)
+      check(wire.paddedTiny == if (wire.pcmSamples < 160) 160 - wire.pcmSamples else 0)
+      val sealToken = "g${wire.generation}:${wire.utteranceId}:${wire.producerInstance}"
+      val content = Content.SealedAudioEmbeddings.fromSealedAudio(
+        wire.rows, wire.pcmSamples, 1536, sealToken, PINNED_SHA256,
+      )
+      val provenance = NativeAudioProvenance(identity, wire.producerInstance,
+        wire.producerSha256, wire.pcmSamples, wire.melFrames, wire.tokens,
+        wire.droppedTail, wire.paddedTiny)
+      val timing = timingSnapshotOnWorker()
+      check(timing == null || timing.isBoundTo(provenance)) { "Timing receipt does not match sealed owner" }
+      return CompletedNativeAudio(content, provenance, timing)
+    } finally {
+      wire.rows.fill(0f)
+    }
+  }
+
+  /** Bounded read-only timing observation; no model call and no row exposure.
+   * At most one optional pre-seal read plus the automatically captured seal read.
+   * Native acceptance/completion stamps are not inferred from Java dispatch/return.
+   */
+  fun timingSnapshotOnWorker(): NativeAudioTimingReceipt? {
+    worker.check()
+    val handle = nativeHandle.get()
+    if (handle == 0L || !clockAlignment.canSnapshot) return null
+    val before = System.nanoTime()
+    val words = NativeAudioOwnerJni.nativeTimingSnapshot(handle) ?: return null
+    val after = System.nanoTime()
+    return try { clockAlignment.snapshot(before, words, after) } finally { words.fill(0L) }
+  }
+
+  /** Returns true only if cancellation preceded JNI completed-result publication.
+   * Always fence the application generation before using any completed payload.
+   */
+  fun requestCancel(): Boolean {
+    val handle = nativeHandle.get()
+    return handle != 0L && NativeAudioOwnerJni.nativeRequestCancel(handle)
+  }
+
+  fun drainOnWorker(timeoutMillis: Long): Boolean {
+    worker.check(); require(timeoutMillis in 0..300000)
+    val handle = nativeHandle.get()
+    return handle == 0L || NativeAudioOwnerJni.nativeDrain(handle, timeoutMillis)
+  }
+
+  /** Timeout retains the registry entry, Java GlobalRef and artifact lease.
+   * Cancellation/poison is terminal; draining never allows utterance reuse.
+   */
+  fun closeOnWorker(timeoutMillis: Long): Boolean {
+    worker.check(); require(timeoutMillis in 0..300000)
+    val handle = nativeHandle.get()
+    if (handle == 0L) return true
+    if (!NativeAudioOwnerJni.nativeClose(handle, timeoutMillis)) return false
+    if (nativeHandle.compareAndSet(handle, 0L)) artifactLease = null
+    return true
+  }
+
+  companion object {
+    const val PINNED_SHA256 = "d5c50b140ace235717e6713d287e73ccfa4f32d0090e1cceb9d00714da850a1b"
+    const val PINNED_BYTES = 103668112L
+
+    fun createOnWorker(worker: NativeAudioWorker, artifact: NativeAudioArtifactLease,
+      identity: NativeAudioIdentity, maxSamples: Int = 480000,
+      maxPacketSamples: Int = 16000, stepTokens: Int = 12,
+      clockContract: NativeClockContract = NativeClockContract.UNVERIFIED): NativeAudioOwner {
+      worker.check()
+      require(maxSamples in 1..480000 && maxPacketSamples in 1..maxSamples && stepTokens in 1..12)
+      // Strict timing ABI preflight precedes native handle/GlobalRef creation.
+      val alignment = NativeClockAlignment.preflight(clockContract.forCurrentPlatform(), NativeAudioOwnerJni::nativeTimingHandshake)
+      verifyPinnedArtifact(artifact)
+      // Allocate the wrapper/AtomicLong BEFORE publishing any native resource.
+      // After nativeCreate succeeds, adoption is one allocation-free atomic store.
+      val owner = NativeAudioOwner(0L, worker, identity, maxPacketSamples, artifact, alignment)
+      val handle = NativeAudioOwnerJni.nativeCreate(artifact, artifact.immutablePath,
+        identity.utteranceId, identity.generation, maxSamples, maxPacketSamples, stepTokens)
+      check(handle > 0)
+      owner.nativeHandle.set(handle)
+      return owner
+    }
+
+    private fun verifyPinnedArtifact(artifact: NativeAudioArtifactLease) {
+      artifact.checkImmutableAndLive()
+      val path = artifact.immutablePath
+      require(path.length in 1..4096 && path.all { it.code in 0x20..0x7e }) {
+        "Prototype requires a bounded ASCII local artifact path"
+      }
+      val file = File(path)
+      require(file.isAbsolute && file.isFile && file.length() == PINNED_BYTES)
+      val digest = MessageDigest.getInstance("SHA-256")
+      val bytes = ByteArray(1024 * 1024)
+      var count = 0L
+      try {
+        file.inputStream().use { stream ->
+          while (true) {
+            val n = stream.read(bytes)
+            if (n < 0) break
+            count += n
+            require(count <= PINNED_BYTES)
+            digest.update(bytes, 0, n)
+          }
+        }
+      } finally { bytes.fill(0) }
+      require(count == PINNED_BYTES && file.length() == PINNED_BYTES)
+      val actual = digest.digest().joinToString("") { "%02x".format(it.toInt() and 255) }
+      require(actual == PINNED_SHA256) { "Pinned native artifact mismatch" }
+      artifact.checkImmutableAndLive()
+      // The app's immutable lease must close the verification→native-open TOCTOU
+      // gap. Neither a caller's path/hash nor this object authenticates that lease.
+    }
+
+
+  }
+}
+
+internal class NativeAudioSealWire(
+  val rows: FloatArray,
+  val pcmSamples: Int,
+  val melFrames: Int,
+  val tokens: Int,
+  val generation: Long,
+  val producerInstance: Long,
+  val utteranceId: String,
+  val producerSha256: String,
+  val droppedTail: Int,
+  val paddedTiny: Int,
+)
+
