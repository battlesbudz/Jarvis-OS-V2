diff --git a/experimental/native_audio_owner_20261006/lifecycle_tests.cc b/experimental/native_audio_owner_20261006/lifecycle_tests.cc
new file mode 100644
index 0000000..35789bb
--- /dev/null
+++ b/experimental/native_audio_owner_20261006/lifecycle_tests.cc
@@ -0,0 +1,214 @@
+// Injected backends ONLY: native C++ lifetime/control-flow tests, not real model
+// or real MiniAudio arithmetic coverage. Run separately from real_native_tests.
+#include "native_audio_owner.h"
+#include <algorithm>
+#include <atomic>
+#include <condition_variable>
+#include <cmath>
+#include <iostream>
+#include <limits>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#include <utility>
+
+namespace n = native_audio;
+using namespace std::chrono_literals;
+namespace {
+void Require(bool value, const char* reason) { if (!value) throw std::runtime_error(reason); }
+struct Barrier {
+  std::mutex mutex; std::condition_variable cv; bool entered=false, released=false;
+  void Stop() {
+    std::unique_lock<std::mutex> lock(mutex); entered=true; cv.notify_all();
+    if (!cv.wait_for(lock,5s,[&]{return released;})) throw std::runtime_error("test barrier timeout");
+  }
+  void Await() {
+    std::unique_lock<std::mutex> lock(mutex);
+    if (!cv.wait_for(lock,5s,[&]{return entered;})) throw std::runtime_error("test entry timeout");
+  }
+  void Release() { std::lock_guard<std::mutex> lock(mutex); released=true; cv.notify_all(); }
+};
+struct State {
+  std::atomic<size_t> hops{0}, steps{0}, destroyed{0};
+  bool fail_frontend=false, fail_step=false, invalid_count=false, invalid_finite=false;
+  bool throw_frontend=false, throw_step=false;
+  std::shared_ptr<Barrier> step_barrier, destructor_barrier;
+  std::function<void()> in_step;
+  std::vector<size_t> frames;
+  std::vector<bool> finals;
+};
+class Fake final : public n::Backend {
+ public:
+  explicit Fake(std::shared_ptr<State> state) : state_(std::move(state)) {}
+  ~Fake() override {
+    if (state_->destructor_barrier) state_->destructor_barrier->Stop();
+    ++state_->destroyed;
+  }
+  n::Producer producer() const override { return {"LIFECYCLE_FAKE","","","",0}; }
+  n::Status Frontend(const float* pcm,size_t count,std::array<float,n::kMelWidth>* mel) override {
+    ++state_->hops;
+    if(state_->throw_frontend) throw std::runtime_error("injected frontend exception");
+    if (state_->fail_frontend) return {n::Code::kNativeFailure,"injected consumed frontend failure"};
+    Require(count && count<=n::kHop,"owner frontend size");
+    float sum=0; for(size_t i=0;i<count;++i) sum+=pcm[i];
+    mel->fill(sum);
+    return n::Status::Ok();
+  }
+  n::Status Step(const std::array<float,n::kStepFrames*n::kMelWidth>& mel,
+                 size_t frames,bool final,n::StepRows* rows) override {
+    ++state_->steps;
+    if(state_->throw_step) throw std::runtime_error("injected step exception");
+    state_->frames.push_back(frames); state_->finals.push_back(final);
+    if(state_->in_step) state_->in_step();
+    if(state_->step_barrier) state_->step_barrier->Stop();
+    if(state_->fail_step) return {n::Code::kNativeFailure,"injected consumed model failure"};
+    rows->count=(frames+3)/4 + (state_->invalid_count?1:0);
+    for(size_t row=0;row<(frames+3)/4;++row)
+      std::fill_n(rows->values.begin()+row*n::kEmbeddingWidth,n::kEmbeddingWidth,
+                  mel[row*4*n::kMelWidth]+static_cast<float>(next_++));
+    if(state_->invalid_finite) rows->values[0]=std::numeric_limits<float>::infinity();
+    return n::Status::Ok();
+  }
+ private: std::shared_ptr<State> state_; size_t next_=0;
+};
+n::Identity id{"test-utterance",11};
+n::Owner Make(std::shared_ptr<State> state, n::Limits limits={480000,480000,12},
+              std::function<void()> hook={}) {
+  n::Owner owner;
+  Require(n::LifecycleTestAccess::Create(id,limits,std::make_unique<Fake>(state),
+                                        std::move(hook),&owner).ok(),"create");
+  return owner;
+}
+std::shared_ptr<const n::CompletedAudio> Complete(size_t count,std::vector<size_t> pattern,
+                                                size_t tokens=12) {
+  auto state=std::make_shared<State>(); auto owner=Make(state,{480000,480000,tokens});
+  std::vector<float> pcm(count,0.25f);
+  size_t offset=0,p=0;
+  Require(owner.Append(nullptr,0,id).ok(),"empty append");
+  while(offset<count) {
+    size_t take=std::min(pattern[p++%pattern.size()],count-offset);
+    Require(owner.Append(pcm.data()+offset,take,id).ok(),"partition append"); offset+=take;
+  }
+  auto result=owner.Seal(id); Require(result.status.ok() && result.completed,"seal");
+  const size_t frames=std::max<size_t>(1,count/160);
+  Require(result.completed->pcm_samples()==count && result.completed->mel_frames()==frames &&
+          result.completed->audio_rows()==(frames+3)/4 && result.completed->eoa_rows()==0,"exact counts/no EOA");
+  Require(result.completed->identity()==id && result.completed->producer().instance!=0,"provenance");
+  Require(result.completed->dropped_tail_samples()==(count>=160?count%160:0) &&
+          result.completed->padded_tiny_samples()==(count<160?160-count:0),"tail accounting");
+  for(size_t i=0;i<state->frames.size();++i)
+    Require(state->frames[i]<=48 && (state->finals[i] || state->frames[i]%4==0),"step group schedule");
+  Require(!owner.Seal(id).status.ok() && !owner.Append(pcm.data(),1,id).ok(),"repeat seal/append rejected");
+  Require(owner.Inspect().completed_publications==1,"single publication");
+  Require(owner.RequestCancel()==n::CancelResult::kAlreadyPublished,"late cancel is later event");
+  auto before=result.completed->rows();
+  Require(owner.CloseOnWorker(1s).ok() && state->destroyed==1,"close destroyed backend");
+  Require(before==result.completed->rows(),"immutable rows survive backend close");
+  Require(owner.RequestCancel()==n::CancelResult::kAlreadyPublished,"published result remains published after close");
+  return result.completed;
+}
+void Partitions() {
+  for(size_t count:{1,2,159,160,161,319,320,321,639,640,641,1279,1280,1281,7680,7681,16017}) {
+    auto whole=Complete(count,{count});
+    auto variable=Complete(count,{1,159,160,161,317,4096});
+    Require(whole->rows()==variable->rows(),"fake partition control mismatch");
+  }
+  auto frequent=Complete(16017,{1,159,160,161},1);
+  auto batched=Complete(16017,{16017},12);
+  Require(frequent->rows()==batched->rows(),"fake variable model grouping");
+}
+void Prevalidation() {
+  auto state=std::make_shared<State>(); auto owner=Make(state,{640,640,12});
+  float good[640]{}; float bad=std::numeric_limits<float>::quiet_NaN();
+  Require(owner.Seal(id).status.code==n::Code::kInvalid,"empty seal");
+  Require(owner.CloseOnWorker(-1ms).code==n::Code::kInvalid,"negative close prevalidation");
+  Require(owner.CloseOnWorker(std::chrono::milliseconds::max()).code==n::Code::kInvalid,"overflowing close prevalidation");
+  Require(owner.DrainOnWorker(std::chrono::milliseconds::max()).code==n::Code::kInvalid,"overflowing drain prevalidation");
+  Require(owner.Append(good,1,{id.utterance_id,12}).code==n::Code::kStale,"stale generation");
+  Require(owner.Append(good,1,{"other",11}).code==n::Code::kStale,"stale utterance");
+  Require(owner.Append(good,641,id).code==n::Code::kBudget,"packet limit before scan");
+  Require(owner.Append(&bad,1,id).code==n::Code::kInvalid,"nonfinite");
+  Require(owner.Append(nullptr,1,id).code==n::Code::kInvalid,"null");
+  Require(owner.Append(good,1,id,48000,1).code==n::Code::kInvalid,"sample rate");
+  Require(owner.Append(good,1,id,16000,2).code==n::Code::kInvalid,"channels");
+  auto snapshot=owner.Inspect();
+  Require(snapshot.phase==n::Phase::kOpen && !snapshot.in_flight && snapshot.pcm_samples==0 && state->hops==0,"rejections mutate nothing");
+  Require(owner.Append(good,640,id).ok(),"valid after rejects");
+  Require(owner.Append(good,1,id).code==n::Code::kBudget && owner.Inspect().pcm_samples==640,"total budget");
+  Require(owner.Seal(id).status.ok(),"seal valid after total-budget rejection");
+  Require(owner.CloseOnWorker(1s).ok(),"close");
+}
+void Poison() {
+  for(int fault=0;fault<6;++fault) {
+    auto state=std::make_shared<State>();
+    state->fail_frontend=fault==0; state->fail_step=fault==1;
+    state->invalid_count=fault==2; state->invalid_finite=fault==3;
+    state->throw_frontend=fault==4; state->throw_step=fault==5;
+    auto owner=Make(state); std::vector<float> pcm(7680);
+    Require(!owner.Append(pcm.data(),pcm.size(),id).ok(),"consumed fault must fail");
+    Require(owner.Inspect().phase==n::Phase::kFailed && owner.Inspect().pcm_samples==7680,"poison after consumption");
+    Require(!owner.Append(pcm.data(),1,id).ok() && !owner.Seal(id).status.ok(),"poison never reused");
+    Require(owner.Inspect().completed_publications==0 && owner.CloseOnWorker(1s).ok(),"no failed publish");
+  }
+}
+void CancelDuringNative(bool at_seal) {
+  auto state=std::make_shared<State>(); state->step_barrier=std::make_shared<Barrier>();
+  auto owner=Make(state); auto worker_owner=owner; std::vector<float> pcm(at_seal?160:7680);
+  if(at_seal) Require(owner.Append(pcm.data(),pcm.size(),id).ok(),"hold final frame");
+  n::Status status; n::SealResult result;
+  std::thread worker([&]{ if(at_seal) result=worker_owner.Seal(id);
+                          else status=worker_owner.Append(pcm.data(),pcm.size(),id); });
+  state->step_barrier->Await();
+  Require(owner.Append(pcm.data(),1,id).code==n::Code::kBusy,"concurrent append bounded");
+  Require(owner.Seal(id).status.code==n::Code::kBusy,"concurrent seal bounded");
+  Require(owner.RequestCancel()==n::CancelResult::kCancelledBeforePublication,"cancel native call");
+  Require(owner.DrainOnWorker(0ms).code==n::Code::kTimeout,"checked busy drain");
+  Require(owner.CloseOnWorker(0ms).code==n::Code::kTimeout && state->destroyed==0,"in-flight model lease retained");
+  owner=n::Owner();  // Worker uses its independently copied strong handle.
+  state->step_barrier->Release(); worker.join();
+  Require(at_seal ? (!result.status.ok() && !result.completed) : !status.ok(),"cancel suppresses result");
+  Require(worker_owner.Inspect().completed_publications==0 && worker_owner.DrainOnWorker(1s).ok(),"cancel drained");
+  Require(worker_owner.CloseOnWorker(1s).ok() && state->destroyed==1,"release only after drain");
+}
+void PublicationBoundary() {
+  auto state=std::make_shared<State>(); auto barrier=std::make_shared<Barrier>();
+  auto owner=Make(state,{480000,480000,12},[&]{barrier->Stop();});
+  std::vector<float> pcm(160); Require(owner.Append(pcm.data(),pcm.size(),id).ok(),"append");
+  n::SealResult result; auto worker_owner=owner;
+  std::thread worker([&]{result=worker_owner.Seal(id);}); barrier->Await();
+  Require(owner.RequestCancel()==n::CancelResult::kCancelledBeforePublication,"cancel before exact commit");
+  barrier->Release(); worker.join();
+  Require(!result.status.ok() && !result.completed && owner.Inspect().completed_publications==0,"no check-then-publish race");
+  Require(owner.CloseOnWorker(1s).ok(),"close");
+}
+void ReentrantDrain() {
+  auto state=std::make_shared<State>(); auto owner=Make(state); std::vector<float> pcm(7680);
+  state->in_step=[&]{
+    Require(owner.DrainOnWorker(0ms).code==n::Code::kWouldDeadlock,"self drain rejected");
+    Require(owner.CloseOnWorker(0ms).code==n::Code::kWouldDeadlock,"self close rejected");
+    Require(owner.Inspect().phase==n::Phase::kOpen,"self close rejection does not cancel");
+  };
+  Require(owner.Append(pcm.data(),pcm.size(),id).ok(),"reentrant check kept operation valid");
+  Require(owner.Seal(id).status.ok() && owner.CloseOnWorker(1s).ok(),"close");
+}
+void ConcurrentClose() {
+  auto state=std::make_shared<State>(); state->destructor_barrier=std::make_shared<Barrier>();
+  auto owner=Make(state); auto closer_owner=owner; n::Status status;
+  std::thread closer([&]{status=closer_owner.CloseOnWorker(5s);});
+  state->destructor_barrier->Await();
+  Require(owner.CloseOnWorker(0ms).code==n::Code::kTimeout,"second close cannot race destruction");
+  Require(owner.DrainOnWorker(0ms).code==n::Code::kTimeout,"destruction is leased operation");
+  state->destructor_barrier->Release(); closer.join();
+  Require(status.ok() && owner.CloseOnWorker(1s).ok() && state->destroyed==1,"close exactly once");
+}
+}
+int main() {
+  try {
+    Partitions(); Prevalidation(); Poison(); CancelDuringNative(false);
+    CancelDuringNative(true); PublicationBoundary(); ReentrantDrain(); ConcurrentClose();
+    std::cout << "{\"passed\":true,\"suite\":\"injected-native-cpp-lifecycle-only\",\"real_model_loaded\":false,\"groups\":8}\n";
+    return 0;
+  } catch(const std::exception& error) {
+    std::cerr << "LIFECYCLE_TEST_ERROR " << error.what() << '\n'; return 2;
+  }
+}
diff --git a/experimental/native_audio_owner_20261006/native_audio_owner.cc b/experimental/native_audio_owner_20261006/native_audio_owner.cc
new file mode 100644
index 0000000..edce9d1
--- /dev/null
+++ b/experimental/native_audio_owner_20261006/native_audio_owner.cc
@@ -0,0 +1,368 @@
+#include "native_audio_owner.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <condition_variable>
+#include <exception>
+#include <mutex>
+#include <thread>
+#include <utility>
+#include <limits>
+#include <time.h>
+
+namespace native_audio {
+namespace {
+Status Error(Code code, const char* message) { return {code, message}; }
+std::atomic<uint64_t> next_instance{1};
+class PlatformTimingClock final : public TimingClock {
+ public:
+  int64_t NowNanos() noexcept override { return NativeMonotonicNowNanos(); }
+};
+}
+int64_t NativeMonotonicNowNanos() noexcept {
+  timespec value{};
+  if (clock_gettime(CLOCK_MONOTONIC, &value) != 0 || value.tv_sec < 0 ||
+      value.tv_nsec < 0 || value.tv_nsec >= 1000000000) return -1;
+  constexpr int64_t kMax = std::numeric_limits<int64_t>::max();
+  if (static_cast<uint64_t>(value.tv_sec) > static_cast<uint64_t>((kMax-value.tv_nsec)/1000000000)) return -1;
+  return static_cast<int64_t>(value.tv_sec)*1000000000 + value.tv_nsec;
+}
+std::array<int64_t, 3> NativeTimingHandshake() noexcept {
+  return {kTimingSchema, kTimingClockMonotonicNs, NativeMonotonicNowNanos()};
+}
+struct Core {
+  Core(Identity id, Limits lim, std::unique_ptr<Backend> native,
+       std::function<void()> hook, std::shared_ptr<TimingClock> source)
+      : identity(std::move(id)), limits(lim), backend(std::move(native)),
+        producer(backend->producer()), before_publication(std::move(hook)),
+        timing_clock(source ? std::move(source) : std::make_shared<PlatformTimingClock>()) {
+    producer.instance = next_instance.fetch_add(1, std::memory_order_relaxed);
+    const size_t max_frames = std::max<size_t>(1, limits.max_samples / kHop);
+    max_row_values = ((max_frames + 3) / 4) * kEmbeddingWidth;
+    rows.reserve(max_row_values);
+  }
+  ~Core() { Wipe(); }  // Last in-flight shared_ptr prevents early destruction.
+
+  Status ValidateOpenLocked(const Identity& id) const {
+    if (!(id == identity)) return Error(Code::kStale, "stale utterance/generation");
+    if (phase == Phase::kCancelled) return Error(Code::kCancelled, "cancelled");
+    if (phase != Phase::kOpen) return Error(Code::kNotOpen, "owner is terminal");
+    if (in_flight) return Error(Code::kBusy, "one native operation already active");
+    return Status::Ok();
+  }
+  Status CheckRunning() const {
+    std::lock_guard<std::mutex> lock(gate);
+    return phase == Phase::kOpen ? Status::Ok() :
+        Error(Code::kCancelled, "operation invalidated before publication");
+  }
+  int64_t StampLocked() noexcept {
+    const int64_t now = timing_clock->NowNanos();
+    if (now < 0) {
+      timing_flags = (timing_flags & ~kTimingClockValid) | kTimingClockReadFailed;
+      return -1;
+    }
+    if (last_event_ns >= 0 && now < last_event_ns) {
+      timing_flags = (timing_flags & ~kTimingClockValid) | kTimingClockReversed;
+      return -1;
+    }
+    last_event_ns = now;
+    return now;
+  }
+  void BeginLocked() { in_flight = true; worker = std::this_thread::get_id(); }
+  void EndLocked() {
+    reported_mel = mel_count;
+    reported_rows = rows_count;
+    in_flight = false;
+    worker = {};
+    idle.notify_all();
+  }
+  // Never called concurrently with a native operation. Best-effort host wipe;
+  // does not promise secure erasure of delegate arenas or caller PCM storage.
+  void Wipe() {
+    hop.fill(0); mel.fill(0);
+    std::fill(rows.begin(), rows.end(), 0.0f);
+    rows.clear(); hop_count = 0; pending_frames = 0;
+  }
+  Status FailConsumed(Status reason) {
+    Wipe();
+    std::lock_guard<std::mutex> lock(gate);
+    if (phase != Phase::kCancelled) phase = Phase::kFailed;
+    EndLocked();
+    return reason;
+  }
+  Status AddFrame(const std::array<float, kMelWidth>& frame) {
+    if (!std::all_of(frame.begin(), frame.end(), [](float x){ return std::isfinite(x); }))
+      return Error(Code::kNativeFailure, "non-finite native Mel frame");
+    std::copy(frame.begin(), frame.end(), mel.begin() + pending_frames * kMelWidth);
+    ++pending_frames; ++mel_count;
+    if (pending_frames == limits.step_tokens * 4) return RunStep(false);
+    return Status::Ok();
+  }
+  Status RunStep(bool final) {
+    auto status = CheckRunning();
+    if (!status.ok()) return status;
+    const size_t expected = (pending_frames + 3) / 4;
+    if (!pending_frames || pending_frames > kStepFrames ||
+        (!final && pending_frames % 4))
+      return Error(Code::kNativeFailure, "invalid owner model schedule");
+    StepRows next;
+    status = backend->Step(mel, pending_frames, final, &next);
+    if (!status.ok()) return status;
+    status = CheckRunning();
+    if (!status.ok()) return status;
+    if (next.count != expected || next.count > kStepTokens ||
+        rows.size() + next.count * kEmbeddingWidth > max_row_values)
+      return Error(Code::kNativeFailure, "native row count/budget mismatch");
+    const auto end = next.values.begin() + next.count * kEmbeddingWidth;
+    if (!std::all_of(next.values.begin(), end, [](float x){ return std::isfinite(x); }))
+      return Error(Code::kNativeFailure, "non-finite native post-adapter row");
+    rows.insert(rows.end(), next.values.begin(), end);
+    rows_count += next.count;
+    mel.fill(0); pending_frames = 0;
+    {
+      std::lock_guard<std::mutex> lock(gate);
+      if (phase != Phase::kOpen)
+        return Error(Code::kCancelled, "step invalidated before timing commit");
+      const int64_t stamp = StampLocked();
+      ++timing_completed_steps;
+      timing_validated_rows += next.count;
+      if (timing_completed_steps == 1) first_step_ns = stamp;
+      last_step_ns = stamp;
+    }
+    return Status::Ok();
+  }
+  Status ConsumeHop(size_t count) {
+    auto status = CheckRunning();
+    if (!status.ok()) return status;
+    std::array<float, kMelWidth> frame{};
+    status = backend->Frontend(hop.data(), count, &frame);
+    if (!status.ok()) return status;
+    status = CheckRunning();
+    if (!status.ok()) return status;
+    hop.fill(0); hop_count = 0;
+    return AddFrame(frame);
+  }
+  std::shared_ptr<const CompletedAudio> MakeCompleted() {
+    return std::shared_ptr<const CompletedAudio>(new const CompletedAudio(
+        identity, producer, samples, mel_count,
+        samples >= kHop ? samples % kHop : 0,
+        samples < kHop ? kHop - samples : 0, std::move(rows)));
+  }
+
+  // Only the short gate is shared with RequestCancel. It is never held during
+  // native calls, completion assembly, callbacks, or waiting for a native call.
+  mutable std::mutex gate;
+  mutable std::condition_variable idle;
+  Phase phase = Phase::kOpen;
+  bool in_flight = false;
+  std::thread::id worker;
+  Identity identity;
+  Limits limits;
+  std::unique_ptr<Backend> backend;
+  Producer producer;
+  std::function<void()> before_publication;
+  std::shared_ptr<TimingClock> timing_clock;
+  int64_t timing_flags = kTimingClockValid, last_event_ns = -1;
+  int64_t first_accepted_ns = -1, first_step_ns = -1, last_step_ns = -1, seal_ns = -1;
+  size_t timing_completed_steps = 0, timing_validated_rows = 0;
+  size_t samples = 0, mel_count = 0, rows_count = 0, max_row_values = 0;
+  size_t reported_mel = 0, reported_rows = 0, publications = 0;
+  std::array<float, kHop> hop{};
+  size_t hop_count = 0;
+  std::array<float, kStepFrames * kMelWidth> mel{};
+  size_t pending_frames = 0;
+  std::vector<float> rows;
+};
+
+Status LifecycleTestAccess::Create(Identity id, Limits limits,
+    std::unique_ptr<Backend> backend, std::function<void()> hook, Owner* out,
+    std::shared_ptr<TimingClock> clock) {
+  if (!out || !backend || id.utterance_id.empty() || id.utterance_id.size() > 256 ||
+      !id.generation || !limits.max_samples || limits.max_samples > kMaxSamples ||
+      !limits.max_packet_samples || limits.max_packet_samples > limits.max_samples ||
+      !limits.step_tokens || limits.step_tokens > kStepTokens)
+    return Error(Code::kInvalid, "invalid identity/limits/backend");
+  try {
+    auto core = std::make_shared<Core>(std::move(id), limits, std::move(backend), std::move(hook), std::move(clock));
+    *out = Owner(std::move(core));
+    return Status::Ok();
+  } catch (...) { return Error(Code::kNativeFailure, "owner initialization failed"); }
+}
+Status Owner::Create(Identity id, Limits limits, std::unique_ptr<Backend> backend, Owner* out) {
+  return LifecycleTestAccess::Create(std::move(id), limits, std::move(backend), {}, out);
+}
+Status Owner::Append(const float* pcm, size_t count, const Identity& id,
+                     int rate, int channels) const {
+  auto core = core_;
+  if (!core) return Error(Code::kNotOpen, "empty owner handle");
+  // Complete non-consuming prevalidation. Bound scan before touching caller data.
+  if (rate != 16000 || channels != 1 || (count && !pcm))
+    return Error(Code::kInvalid, "finite 16 kHz mono float32 PCM required");
+  if (count > core->limits.max_packet_samples)
+    return Error(Code::kBudget, "packet sample budget exceeded");
+  for (size_t i = 0; i < count; ++i)
+    if (!std::isfinite(pcm[i])) return Error(Code::kInvalid, "non-finite PCM rejected");
+  {
+    std::lock_guard<std::mutex> lock(core->gate);
+    auto status = core->ValidateOpenLocked(id);
+    if (!status.ok()) return status;
+    if (count > core->limits.max_samples - core->samples)
+      return Error(Code::kBudget, "utterance sample budget exceeded");
+    if (!count) return Status::Ok();
+    // Latch only after every non-consuming validation passed, at native admission.
+    if (core->samples == 0) core->first_accepted_ns = core->StampLocked();
+    core->BeginLocked();
+    core->samples += count;  // Admission/consumption begins here; failures poison.
+  }
+  try {
+    size_t offset = 0;
+    while (offset < count) {
+      auto status = core->CheckRunning();
+      if (!status.ok()) return core->FailConsumed(status);
+      const size_t take = std::min(kHop - core->hop_count, count - offset);
+      std::copy_n(pcm + offset, take, core->hop.begin() + core->hop_count);
+      offset += take; core->hop_count += take;
+      if (core->hop_count == kHop) {
+        status = core->ConsumeHop(kHop);
+        if (!status.ok()) return core->FailConsumed(status);
+      }
+    }
+    // Linearize acknowledgement with cancellation, without publishing rows.
+    std::unique_lock<std::mutex> lock(core->gate);
+    if (core->phase != Phase::kOpen) {
+      lock.unlock();
+      return core->FailConsumed(Error(Code::kCancelled, "append cancelled"));
+    }
+    core->EndLocked();
+    return Status::Ok();
+  } catch (...) {
+    return core->FailConsumed(Error(Code::kNativeFailure, "exception after PCM admission"));
+  }
+}
+SealResult Owner::Seal(const Identity& id) const {
+  auto core = core_;
+  if (!core) return {Error(Code::kNotOpen, "empty owner handle"), {}};
+  {
+    std::lock_guard<std::mutex> lock(core->gate);
+    auto status = core->ValidateOpenLocked(id);
+    if (!status.ok()) return {status, {}};
+    if (!core->samples) return {Error(Code::kInvalid, "empty capture cannot seal"), {}};
+    core->BeginLocked();
+  }
+  try {
+    auto fail = [&](Status status) -> SealResult { return {core->FailConsumed(status), {}}; };
+    // Stock one-shot policy: tiny whole utterance pads once at true EOS. Once a
+    // complete hop exists, drop the unmatched sub-hop tail, preserving its count.
+    if (core->samples < kHop) {
+      auto status = core->ConsumeHop(core->hop_count);
+      if (!status.ok()) return fail(status);
+    }
+    core->hop.fill(0); core->hop_count = 0;
+    if (core->pending_frames) {
+      auto status = core->RunStep(true);
+      if (!status.ok()) return fail(status);
+    }
+    const size_t frames = std::max<size_t>(1, core->samples / kHop);
+    if (core->mel_count != frames || core->rows_count != (frames + 3) / 4 ||
+        core->rows.size() != core->rows_count * kEmbeddingWidth)
+      return fail(Error(Code::kNativeFailure, "complete utterance count mismatch"));
+    auto candidate = core->MakeCompleted();
+    if (core->before_publication) core->before_publication();
+    std::unique_lock<std::mutex> lock(core->gate);
+    if (core->phase != Phase::kOpen) {
+      lock.unlock();
+      return fail(Error(Code::kCancelled, "seal cancelled before publication"));
+    }
+    // This is the sole publication boundary and shares RequestCancel's mutex.
+    // There is no learned EOA in candidate. The Conversation bridge must emit
+    // its InputAudioEnd/-4 exactly once after the admitted sealed payload.
+    core->phase = Phase::kSealed;
+    core->seal_ns = core->StampLocked();
+    ++core->publications;
+    core->EndLocked();
+    return {Status::Ok(), std::move(candidate)};
+  } catch (...) {
+    return {core->FailConsumed(Error(Code::kNativeFailure, "exception during seal")), {}};
+  }
+}
+CancelResult Owner::RequestCancel() const {
+  auto core = core_;
+  if (!core) return CancelResult::kAlreadyTerminal;
+  std::lock_guard<std::mutex> lock(core->gate);
+  if (core->publications != 0) return CancelResult::kAlreadyPublished;
+  if (core->phase != Phase::kOpen) return CancelResult::kAlreadyTerminal;
+  core->phase = Phase::kCancelled;
+  return CancelResult::kCancelledBeforePublication;
+}
+Snapshot Owner::Inspect() const {
+  auto core = core_;
+  if (!core) return {Phase::kClosed, false, 0, 0, 0, 0};
+  std::lock_guard<std::mutex> lock(core->gate);
+  return {core->phase, core->in_flight, core->samples, core->reported_mel,
+          core->reported_rows, core->publications};
+}
+TimingSnapshot Owner::InspectTiming() const {
+  auto core = core_;
+  if (!core) return {};
+  std::lock_guard<std::mutex> lock(core->gate);
+  TimingSnapshot result;
+  result.phase = core->phase;
+  result.producer_instance = core->producer.instance <= static_cast<uint64_t>(std::numeric_limits<int64_t>::max())
+      ? static_cast<int64_t>(core->producer.instance) : 0;
+  result.flags = core->timing_flags;
+  const int64_t now = core->timing_clock->NowNanos();
+  if (now < 0) result.flags = (result.flags & ~kTimingClockValid) | kTimingClockReadFailed;
+  else if (core->last_event_ns >= 0 && now < core->last_event_ns)
+    result.flags = (result.flags & ~kTimingClockValid) | kTimingClockReversed;
+  else result.snapshot_native_ns = now;
+  result.first_accepted_native_ns = core->first_accepted_ns;
+  result.accepted_pcm_samples = core->samples;
+  result.completed_steps = core->timing_completed_steps;
+  result.validated_rows = core->timing_validated_rows;
+  result.first_step_native_ns = core->first_step_ns;
+  result.last_step_native_ns = core->last_step_ns;
+  result.seal_native_ns = core->seal_ns;
+  return result;
+}
+Status Owner::DrainOnWorker(std::chrono::milliseconds timeout) const {
+  auto core = core_;
+  if (!core) return Status::Ok();
+  if (timeout.count() < 0 || timeout > kMaxDrainTimeout)
+    return Error(Code::kInvalid, "drain timeout outside 0..300000 ms");
+  std::unique_lock<std::mutex> lock(core->gate);
+  if (core->in_flight && core->worker == std::this_thread::get_id())
+    return Error(Code::kWouldDeadlock, "cannot drain this operation from itself");
+  if (!core->idle.wait_for(lock, timeout, [&]{ return !core->in_flight; }))
+    return Error(Code::kTimeout, "native operation still active; leases retained");
+  return Status::Ok();
+}
+Status Owner::CloseOnWorker(std::chrono::milliseconds timeout) const {
+  auto core = core_;
+  if (!core) return Status::Ok();
+  if (timeout.count() < 0 || timeout > kMaxDrainTimeout)
+    return Error(Code::kInvalid, "close timeout outside 0..300000 ms");
+  {
+    // Wait and acquire the exclusive closing operation in the SAME gate lock.
+    // Concurrent closers cannot report completion during backend destruction.
+    std::unique_lock<std::mutex> lock(core->gate);
+    if (core->in_flight && core->worker == std::this_thread::get_id())
+      return Error(Code::kWouldDeadlock, "cannot close this operation from itself");
+    // Reject invalid self-close before changing semantic state. Otherwise
+    // invalidate before waiting, under the same cancel/publication gate.
+    if (core->phase == Phase::kOpen) core->phase = Phase::kCancelled;
+    if (!core->idle.wait_for(lock, timeout, [&]{ return !core->in_flight; }))
+      return Error(Code::kTimeout, "native operation still active; leases retained");
+    if (core->phase == Phase::kClosed) return Status::Ok();
+    core->phase = Phase::kClosed;
+    core->BeginLocked();
+  }
+  core->Wipe();
+  core->backend.reset();
+  {
+    std::lock_guard<std::mutex> lock(core->gate);
+    core->EndLocked();
+  }
+  return Status::Ok();
+}
+}  // namespace native_audio
diff --git a/experimental/native_audio_owner_20261006/native_audio_owner.h b/experimental/native_audio_owner_20261006/native_audio_owner.h
new file mode 100644
index 0000000..8862e3e
--- /dev/null
+++ b/experimental/native_audio_owner_20261006/native_audio_owner.h
@@ -0,0 +1,181 @@
+#ifndef RESEARCH_NATIVE_AUDIO_OWNER_H_
+#define RESEARCH_NATIVE_AUDIO_OWNER_H_
+
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+// Research-only, synchronous encoder ownership. No capture, Conversation, LLM,
+// automatic tool calling, permissions, model download or unbounded work queue.
+namespace native_audio {
+constexpr size_t kHop = 160, kMelWidth = 128, kStepFrames = 48;
+constexpr size_t kStepTokens = 12, kEmbeddingWidth = 1536;
+constexpr std::chrono::milliseconds kMaxDrainTimeout{300000};
+constexpr size_t kMaxSamples = 480000;  // 30 seconds at exactly 16 kHz mono.
+
+enum class Code { kOk, kInvalid, kStale, kBudget, kBusy, kNotOpen,
+                  kCancelled, kNativeFailure, kTimeout, kWouldDeadlock };
+struct Status {
+  Code code = Code::kOk;
+  const char* message = "";  // Static diagnostic only; no PCM or allocation.
+  bool ok() const { return code == Code::kOk; }
+  static Status Ok() { return {}; }
+};
+struct Identity {
+  std::string utterance_id;
+  uint64_t generation = 0;
+  bool operator==(const Identity& other) const {
+    return generation == other.generation && utterance_id == other.utterance_id;
+  }
+};
+struct Producer {
+  std::string implementation, sdk_pin, litert_pin, expected_model_sha256;
+  uint64_t instance = 0;  // Process-local provenance, never authentication.
+};
+struct Limits {
+  size_t max_samples = kMaxSamples;
+  size_t max_packet_samples = 16000;
+  size_t step_tokens = kStepTokens;
+};
+struct StepRows {
+  size_t count = 0;
+  std::array<float, kStepTokens * kEmbeddingWidth> values{};
+};
+
+// A fresh backend is exclusively owned by one utterance. Its explicit native
+// caches and TensorBuffers cannot be shared with another owner. Methods are
+// synchronous: success OR failure must mean all native buffer use has ended.
+// Backend exceptions are caught by the owner and poison consumed utterances.
+class Backend {
+ public:
+  virtual ~Backend() = default;
+  virtual Producer producer() const = 0;
+  // Exactly one complete 160-sample hop, or 1..159 once for a tiny utterance at
+  // true EOS. Both cases must produce exactly one 128-value Mel frame.
+  virtual Status Frontend(const float* pcm, size_t samples,
+                          std::array<float, kMelWidth>* mel) = 0;
+  // New valid Mel prefix; unused rows are zero. Partial groups only at seal.
+  // Own and validate all returned state before exposing valid post-adapter rows.
+  virtual Status Step(const std::array<float, kStepFrames * kMelWidth>& mel,
+                      size_t frames, bool final, StepRows* rows) = 0;
+};
+
+// Versioned diagnostics only. Counts/times never authorize model or tool effects.
+constexpr int64_t kTimingSchema = 1, kTimingClockMonotonicNs = 1;
+constexpr int64_t kTimingClockValid = 1, kTimingClockReadFailed = 2, kTimingClockReversed = 4;
+class TimingClock {
+ public:
+  virtual ~TimingClock() = default;
+  virtual int64_t NowNanos() noexcept = 0;
+};
+int64_t NativeMonotonicNowNanos() noexcept;
+std::array<int64_t, 3> NativeTimingHandshake() noexcept;
+
+struct Core;
+class CompletedAudio final {
+ public:
+  const Identity& identity() const { return identity_; }
+  const Producer& producer() const { return producer_; }
+  size_t pcm_samples() const { return pcm_samples_; }
+  size_t mel_frames() const { return mel_frames_; }
+  size_t audio_rows() const { return rows_.size() / kEmbeddingWidth; }
+  size_t dropped_tail_samples() const { return dropped_tail_samples_; }
+  size_t padded_tiny_samples() const { return padded_tiny_samples_; }
+  const std::vector<float>& rows() const { return rows_; }
+  static constexpr size_t eoa_rows() { return 0; }
+ private:
+  friend struct Core;
+  CompletedAudio(Identity identity, Producer producer, size_t pcm, size_t mel,
+                 size_t dropped, size_t padded, std::vector<float> rows)
+      : identity_(std::move(identity)), producer_(std::move(producer)),
+        pcm_samples_(pcm), mel_frames_(mel), dropped_tail_samples_(dropped),
+        padded_tiny_samples_(padded), rows_(std::move(rows)) {}
+  Identity identity_;
+  Producer producer_;
+  size_t pcm_samples_, mel_frames_, dropped_tail_samples_, padded_tiny_samples_;
+  std::vector<float> rows_;  // Object itself is allocated const; no mutable view.
+};
+struct SealResult { Status status; std::shared_ptr<const CompletedAudio> completed; };
+enum class Phase { kOpen, kSealed, kCancelled, kFailed, kClosed };
+enum class CancelResult { kCancelledBeforePublication, kAlreadyPublished,
+                          kAlreadyTerminal };
+struct Snapshot {
+  Phase phase;
+  bool in_flight;
+  size_t pcm_samples, mel_frames, audio_rows;
+  size_t completed_publications;
+};
+
+// Fixed 12-scalar in-memory receipt. No samples, hashes, transcript or rows.
+struct TimingSnapshot {
+  int64_t schema = kTimingSchema;
+  Phase phase = Phase::kClosed;
+  int64_t producer_instance = 0, flags = 0, snapshot_native_ns = -1;
+  int64_t first_accepted_native_ns = -1, accepted_pcm_samples = 0;
+  int64_t completed_steps = 0, validated_rows = 0;
+  int64_t first_step_native_ns = -1, last_step_native_ns = -1, seal_native_ns = -1;
+  std::array<int64_t, 12> Words() const {
+    return {schema, static_cast<int64_t>(phase), producer_instance, flags,
+      snapshot_native_ns, first_accepted_native_ns, accepted_pcm_samples,
+      completed_steps, validated_rows, first_step_native_ns, last_step_native_ns,
+      seal_native_ns};
+  }
+};
+
+// Successfully CloseOnWorker before dropping the last idle handle on a UI or
+// capture thread; final-handle RAII destruction otherwise runs synchronously
+// on that thread. A future app wrapper may enforce worker-affine destruction.
+// Copy this inexpensive handle for each participating thread. Every call holds
+// its own strong Core lease through native work. Do not race destruction or
+// assignment of the SAME C++ handle object with a member call on that object.
+class Owner final {
+ public:
+  static Status Create(Identity identity, Limits limits,
+                       std::unique_ptr<Backend> backend, Owner* out);
+  // Use a bounded capture-to-worker queue outside this class. Append never
+  // queues or waits for another Append/Seal; concurrent work returns kBusy.
+  // Pointer storage must remain stable for this synchronous call. This method
+  // and Seal belong on workers, never microphone/UI callback threads.
+  Status Append(const float* pcm, size_t samples, const Identity& identity,
+                int sample_rate_hz = 16000, int channels = 1) const;
+  SealResult Seal(const Identity& identity) const;
+  // Fast signal only: no native call, join, wipe or backend destruction. A
+  // cancel linearizing before publication suppresses the completed result.
+  // AlreadyPublished means the app must still fence the generation itself.
+  CancelResult RequestCancel() const;
+  Snapshot Inspect() const;
+  // Read-only scalar copy under the short Core gate; no wait or model invocation.
+  TimingSnapshot InspectTiming() const;
+  // Checked 0..300000 ms timeout and same-operation-thread rejection; no UI-thread magic.
+  // Caller must use a worker. Idle is only a point-in-time observation unless
+  // terminal/cancelled; new Append is still possible while open.
+  Status DrainOnWorker(std::chrono::milliseconds timeout) const;
+  // Invalidate first, drain, wipe host staging, destroy native backend/leases.
+  // A timeout leaves all in-flight leases intact and permits a later retry.
+  Status CloseOnWorker(std::chrono::milliseconds timeout) const;
+ private:
+  friend class LifecycleTestAccess;
+  explicit Owner(std::shared_ptr<Core> core) : core_(std::move(core)) {}
+ public:
+  Owner() = default;
+ private:
+  std::shared_ptr<Core> core_;
+};
+
+// Deliberately labelled fault seam. Not evidence of real model parity. Hooks
+// run outside the publication gate and must not make blocking owner calls.
+class LifecycleTestAccess {
+ public:
+  static Status Create(Identity identity, Limits limits,
+                       std::unique_ptr<Backend> backend,
+                       std::function<void()> before_publication, Owner* out,
+                       std::shared_ptr<TimingClock> clock = {});
+};
+}  // namespace native_audio
+#endif
