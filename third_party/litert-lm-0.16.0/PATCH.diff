+// A pending raw-audio encoder must be untouched by the projected-audio path.
+class PendingRawAudioExecutor : public AudioExecutor {
+ public:
+  explicit PendingRawAudioExecutor(std::shared_ptr<std::atomic<int>> calls)
+      : calls_(std::move(calls)) {}
+  absl::StatusOr<ExecutorAudioData> Encode(const TensorBuffer&) override {
+    ++*calls_;
+    return absl::InternalError("Projected payload must bypass Encode.");
+  }
+  absl::StatusOr<ExecutorAudioData> Flush() override {
+    ++*calls_;
+    return absl::InternalError("Projected end must not flush pending raw audio.");
