diff --git a/experimental/native_audio_owner_20261006/real_native_tests.cc b/experimental/native_audio_owner_20261006/real_native_tests.cc
new file mode 100644
index 0000000..afaa501
--- /dev/null
+++ b/experimental/native_audio_owner_20261006/real_native_tests.cc
@@ -0,0 +1,140 @@
+// Real public MiniAudio + pinned CompiledModel tests. Fixtures stay local. This
+// program never writes model, PCM, Mel, cache, or activation arrays to disk.
+#include "native_audio_owner.h"
+#include "pinned_native_backend.h"
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include "litert/cc/litert_element_type.h"
+#include "litert/cc/litert_tensor_buffer.h"
+#include "support/preprocessor/audio_preprocessor.h"
+#include "support/preprocessor/audio_preprocessor_miniaudio.h"
+#include "support/util/io_types.h"
+namespace n=native_audio;
+using namespace std::chrono_literals;
+namespace {
+void Require(bool value,const char* message) {if(!value) throw std::runtime_error(message);}
+void Check(const n::Status& status) {Require(status.ok(),status.message);}
+template<typename T> std::vector<T> Read(const std::string& path) {
+  std::ifstream file(path,std::ios::binary|std::ios::ate);
+  Require(static_cast<bool>(file),"fixture open failed");
+  auto length=file.tellg();
+  Require(length>0 && length<=8*1024*1024 && length%sizeof(T)==0,"fixture size bound");
+  std::vector<T> values(static_cast<size_t>(length)/sizeof(T)); file.seekg(0);
+  Require(static_cast<bool>(file.read(reinterpret_cast<char*>(values.data()),length)),"fixture read failed");
+  return values;
+}
+void Exact(const std::vector<float>& a,const std::vector<float>& b,const char* message) {
+  Require(a.size()==b.size() && std::memcmp(a.data(),b.data(),a.size()*sizeof(float))==0,message);
+}
+std::vector<float> WholeMel(const std::vector<float>& pcm) {
+  using C=litert::support::AudioPreprocessorConfig;
+  auto config=C::Create(16000,1,320,160,512,1.0f,0.0f,128,0,8000,0.001f,
+                       false,true,true,false,true,C::kCenter,false,false);
+  auto preprocessor=litert::support::AudioPreprocessorMiniAudio::Create(config);
+  Require(preprocessor.ok(),"whole-input frontend create");
+  litert::support::InputAudio input(pcm);
+  auto result=(*preprocessor)->Preprocess(input);
+  Require(result.ok(),"whole-input frontend process");
+  auto tensor=result->GetPreprocessedAudioTensor(); Require(tensor.ok(),"whole-input frontend tensor");
+  auto type=(*tensor)->TensorType(); Require(type.HasValue(),"whole-input frontend type");
+  auto dims=type->Layout().Dimensions();
+  size_t frames=std::max<size_t>(1,pcm.size()/160);
+  Require(type->ElementType()==litert::ElementType::Float32 && dims.size()==3 &&
+          dims[0]==1 && dims[1]==frames && dims[2]==128,"whole-input frontend dimensions");
+  auto locked=litert::TensorBufferScopedLock::Create<float>(**tensor,litert::TensorBuffer::LockMode::kRead);
+  Require(locked.HasValue(),"whole-input frontend lock");
+  return std::vector<float>(locked->second,locked->second+frames*128);
+}
+// Independent owner scheduling reference: single official whole-input frontend
+// call followed by bounded direct steps, with no PCM accumulator/Owner involved.
+std::vector<float> Reference(const std::string& path,const std::vector<float>& mel) {
+  std::unique_ptr<n::Backend> backend;
+  // Research fixture holder only. The launcher's exact local file checks bind
+  // bytes for this test. This opaque object is NOT an application verified lease.
+  Check(n::CreatePinnedBackend(path,std::make_shared<const std::string>(path),&backend));
+  std::vector<float> result;
+  size_t offset=0,frames=mel.size()/128;
+  while(offset<frames) {
+    size_t take=std::min<size_t>(48,frames-offset);
+    std::array<float,n::kStepFrames*n::kMelWidth> input{};
+    std::copy_n(mel.begin()+offset*128,take*128,input.begin());
+    n::StepRows rows;
+    Check(backend->Step(input,take,offset+take==frames,&rows));
+    Require(rows.count==(take+3)/4,"reference token count");
+    result.insert(result.end(),rows.values.begin(),rows.values.begin()+rows.count*1536);
+    offset+=take;
+  }
+  return result;
+}
+std::shared_ptr<const n::CompletedAudio> Stream(const std::string& path,
+    const std::vector<float>& pcm,const std::vector<size_t>& pattern,size_t step_tokens) {
+  std::unique_ptr<n::Backend> backend;
+  Check(n::CreatePinnedBackend(path,std::make_shared<const std::string>(path),&backend));
+  n::Owner owner; n::Identity identity{"local-public-fixture",42};
+  Check(n::Owner::Create(identity,{480000,480000,step_tokens},std::move(backend),&owner));
+  size_t offset=0,i=0;
+  Check(owner.Append(nullptr,0,identity));
+  while(offset<pcm.size()) {
+    size_t take=std::min(pattern[i++%pattern.size()],pcm.size()-offset);
+    Check(owner.Append(pcm.data()+offset,take,identity)); offset+=take;
+  }
+  auto result=owner.Seal(identity); Check(result.status);
+  Require(static_cast<bool>(result.completed),"missing completed payload");
+  const auto& complete=*result.completed;
+  size_t frames=std::max<size_t>(1,pcm.size()/160);
+  Require(complete.pcm_samples()==pcm.size() && complete.mel_frames()==frames &&
+          complete.audio_rows()==(frames+3)/4 && complete.rows().size()==complete.audio_rows()*1536 &&
+          complete.eoa_rows()==0 && complete.identity()==identity,"native complete provenance/counts");
+  Require(complete.dropped_tail_samples()==(pcm.size()>=160?pcm.size()%160:0) &&
+          complete.padded_tiny_samples()==(pcm.size()<160?160-pcm.size():0),"native tail accounting");
+  Require(!owner.Seal(identity).status.ok() && owner.Inspect().completed_publications==1,"native repeat seal");
+  Check(owner.CloseOnWorker(1s));
+  return result.completed;
+}
+}
+int main(int argc,char** argv) {
+  try {
+    Require(argc==7,"MODEL PCM_F32 MEL_F32 STATIC_ADAPTER_F32 STATIC_MASK_U8 smoke|all required");
+    uint32_t endian=1; Require(*reinterpret_cast<uint8_t*>(&endian)==1,"little-endian fixture host required");
+    std::string model=argv[1],suite=argv[6]; Require(suite=="smoke"||suite=="all","unknown suite");
+    auto pcm=Read<float>(argv[2]); auto expected_mel=Read<float>(argv[3]);
+    auto static_rows=Read<float>(argv[4]); auto static_mask=Read<uint8_t>(argv[5]);
+    Require(pcm.size()==49221 && expected_mel.size()==307*128,"complete speech fixture counts");
+    Require(static_mask.size()==204 && static_rows.size()==204*1536,"exact static oracle shape");
+    for(size_t i=0;i<static_mask.size();++i) Require(static_mask[i]==static_cast<uint8_t>(i<77),"static oracle valid prefix");
+    static_rows.resize(77*1536);  // Excludes padded rows and any learned EOA.
+    auto mel=WholeMel(pcm); Exact(mel,expected_mel,"whole public MiniAudio Mel differs from fixture");
+    auto reference=Reference(model,mel); Exact(reference,static_rows,"whole native reference differs from exact static oracle");
+    auto whole=Stream(model,pcm,{pcm.size()},12);
+    auto partitioned=Stream(model,pcm,{1,159,160,161,317,4096},12);
+    Exact(whole->rows(),reference,"whole owner differs from native reference");
+    Exact(partitioned->rows(),reference,"variable packet owner differs from native reference");
+    size_t boundary_cases=0;
+    if(suite=="all") {
+      auto one_token=Stream(model,pcm,{79,1,160,321,4096},1);
+      Exact(one_token->rows(),static_rows,"one-token steps differ from exact static oracle");
+      for(size_t count:{1,2,159,160,161,319,320,321,639,640,641,1279,1280,1281,7680,7681}) {
+        std::vector<float> prefix(pcm.begin(),pcm.begin()+count);
+        auto native_reference=Reference(model,WholeMel(prefix));
+        auto streamed=Stream(model,prefix,{1,159,161,317},12);
+        Exact(streamed->rows(),native_reference,"tiny/partial tail native reference mismatch");
+        ++boundary_cases;
+      }
+    }
+    std::cout<<"{\"passed\":true,\"suite\":\"real-pinned-cpp-owner-"<<suite
+      <<"\",\"pcm_samples\":49221,\"mel_frames\":307,\"audio_rows\":77,\"eoa_rows\":0,"
+      <<"\"frontend_bitwise\":true,\"static_oracle_valid_rows_bitwise\":true,"
+      <<"\"variable_packets_bitwise\":true,\"boundary_cases\":"<<boundary_cases<<"}\n";
+    return 0;
+  } catch(const std::exception& error) {
+    std::cerr<<"REAL_NATIVE_OWNER_TEST_ERROR "<<error.what()<<'\n'; return 2;
+  }
+}
