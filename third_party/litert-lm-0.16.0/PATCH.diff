+#ifndef RESEARCH_PINNED_NATIVE_BACKEND_H_
+#define RESEARCH_PINNED_NATIVE_BACKEND_H_
+#include "native_audio_owner.h"
+
+namespace native_audio {
+// App supplies and retains its already-verified immutable artifact lifetime
+// lease. This opaque handle proves nothing by itself. This prototype does NOT
+// verify a caller's claimed hash or authenticate paths/metadata; the app must
+// bind the verified bytes, immutable path and lease before calling this factory.
+// No download, credentials, mmap-by-user, SDK modification or EOA invocation.
+Status CreatePinnedBackend(const std::string& immutable_model_path,
+    std::shared_ptr<const void> artifact_lifetime_lease,
