+absl::Status InputAudio::ValidateAudioEmbeddings() const {
+  if (!IsAudioEmbeddings() || !IsTensorBuffer()) {
+    return absl::FailedPreconditionError(
+        "Audio is not explicitly marked as projected embeddings.");
+  }
+  const auto& tensor = std::get<::litert::TensorBuffer>(data_);
+  LITERT_ASSIGN_OR_RETURN(auto type, tensor.TensorType());
+  const auto& dims = type.Layout().Dimensions();
+  if (type.ElementType() != ::litert::ElementType::Float32 ||
+      type.Layout().HasStrides() || dims.size() != 3 || dims[0] != 1 ||
+      dims[1] <= 0 || dims[1] > kMaxAudioEmbeddingTokens || dims[2] <= 0 ||
+      dims[2] > kMaxAudioEmbeddingWidth) {
+    return absl::InvalidArgumentError(
+        "Projected audio requires contiguous Float32 [1, 1..750, 1..8192].");
+  }
+  LITERT_ASSIGN_OR_RETURN(auto buffer_type, tensor.BufferType());
+  if (buffer_type != ::litert::TensorBufferType::kHostMemory) {
+    return absl::InvalidArgumentError(
+        "Projected audio must own a host-memory tensor.");
+  }
+  const size_t count = static_cast<size_t>(dims[1]) * dims[2];
+  LITERT_ASSIGN_OR_RETURN(auto bytes, tensor.Size());
+  if (bytes < count * sizeof(float)) {
+    return absl::InvalidArgumentError("Projected audio tensor is undersized.");
+  }
+  LITERT_ASSIGN_OR_RETURN(
+      auto lock_and_addr,
+      ::litert::TensorBufferScopedLock::Create(
+          const_cast<::litert::TensorBuffer&>(tensor),
+          ::litert::TensorBuffer::LockMode::kRead));
+  const auto* values = static_cast<const float*>(lock_and_addr.second);
+  for (size_t i = 0; i < count; ++i) {
+    if (!std::isfinite(values[i])) {
+      return absl::InvalidArgumentError(
+          "Projected audio embeddings must be finite.");
+    }
+  }
+  return absl::OkStatus();
+}
