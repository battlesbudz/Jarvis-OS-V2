+// Keep the owner alive and release the callback admission before detaching,
+// including when serialization or other C++ work throws.
+class ConversationCallbackScope {
+ public:
+  ConversationCallbackScope(std::shared_ptr<ConversationCallbackState> state,
+                            JavaVM* jvm, JNIEnv* env, bool attached)
+      : state_(std::move(state)), jvm_(jvm), env_(env), attached_(attached) {}
+  ~ConversationCallbackScope() {
+    state_->Leave(env_);
+    if (attached_ && jvm_->DetachCurrentThread() != JNI_OK) {
+      ABSL_LOG(ERROR) << "Failed to detach from JVM in callback_fn.";
+    }
+  }
+
+ private:
+  std::shared_ptr<ConversationCallbackState> state_;
+  JavaVM* jvm_;
+  JNIEnv* env_;
+  bool attached_;
+};
