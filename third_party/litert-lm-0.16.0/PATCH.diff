+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <type_traits>
+#include <utility>
+#include <vector>
+#include "experimental/native_audio_owner_20261006/native_audio_owner.h"
+#include "experimental/native_audio_owner_20261006/pinned_native_backend.h"
+
+namespace n = native_audio;
+namespace {
+constexpr size_t kRegistryLimit=8;
+constexpr char kSha[]="d5c50b140ace235717e6713d287e73ccfa4f32d0090e1cceb9d00714da850a1b";
+struct PendingJava {};
+struct OwnerError { n::Code code; const char* message; };
+void CheckJni(JNIEnv* env) { if(env->ExceptionCheck()) throw PendingJava{}; }
+void Require(bool ok,const char* message) { if(!ok) throw std::invalid_argument(message); }
+void Check(n::Status status) { if(!status.ok()) throw OwnerError{status.code,status.message}; }
+void ThrowJava(JNIEnv* env,const char* name,const char* message) noexcept {
+  if(env->ExceptionCheck()) return;  // Preserve, never overwrite, a pending exception.
+  jclass type=env->FindClass(name);
+  if(env->ExceptionCheck() || !type) return;
+  env->ThrowNew(type,message);
+  // DeleteLocalRef is explicitly legal with a pending exception. Do not clear it.
+  env->DeleteLocalRef(type);
+}
+template<typename F> auto Boundary(JNIEnv* env,F&& action) -> decltype(action()) {
+  using R=decltype(action());
+  try {CheckJni(env); return action();}
+  catch(const PendingJava&) {}
+  catch(const OwnerError& error) {
+    ThrowJava(env,error.code==n::Code::kInvalid || error.code==n::Code::kBudget || error.code==n::Code::kStale
+      ?"java/lang/IllegalArgumentException":"java/lang/IllegalStateException",error.message);
+  }
+  catch(const std::invalid_argument& error) {ThrowJava(env,"java/lang/IllegalArgumentException",error.what());}
+  catch(const std::bad_alloc&) {ThrowJava(env,"java/lang/OutOfMemoryError","Native owner allocation failed");}
+  catch(...) {ThrowJava(env,"java/lang/IllegalStateException","Native owner operation failed");}
+  if constexpr(!std::is_void_v<R>) return R{};
+}
+std::string Text(JNIEnv* env,jstring value,size_t bound,bool identity=false) {
+  Require(value!=nullptr,"Required string missing");
+  jsize size=env->GetStringUTFLength(value); CheckJni(env);
+  Require(size>0 && static_cast<size_t>(size)<=bound,"String length outside bound");
+  const char* chars=env->GetStringUTFChars(value,nullptr);
+  if(env->ExceptionCheck()){if(chars)env->ReleaseStringUTFChars(value,chars);throw PendingJava{};}
+  if(!chars) throw std::bad_alloc();
+  std::string result;
+  try {result.assign(chars,static_cast<size_t>(size));}
+  catch(...) {env->ReleaseStringUTFChars(value,chars); throw;}
+  env->ReleaseStringUTFChars(value,chars); CheckJni(env);
+  Require(std::all_of(result.begin(),result.end(),[&](unsigned char c){
+    return identity ? ((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'||c=='-')
+                    : (c>=0x20&&c<=0x7e);
+  }),"Prototype string must use the documented ASCII contract");
+  return result;
+}
+struct JavaLease {
+  JavaVM* vm=nullptr; jobject reference=nullptr;
+  static std::atomic<size_t> live;
+  JavaLease(JNIEnv* env,jobject artifact) {
+    Require(artifact!=nullptr,"Artifact lifetime lease required");
+    Require(env->GetJavaVM(&vm)==JNI_OK && vm,"JVM unavailable"); CheckJni(env);
+    reference=env->NewGlobalRef(artifact);
+    if(env->ExceptionCheck()){if(reference)env->DeleteGlobalRef(reference);reference=nullptr;throw PendingJava{};}
+    if(!reference) throw std::bad_alloc();
+    ++live;
+  }
+  ~JavaLease() {
+    if(!reference) return;
+    JNIEnv* env=nullptr; bool attached=false;
+    jint status=vm->GetEnv(reinterpret_cast<void**>(&env),JNI_VERSION_1_6);
+    if(status==JNI_EDETACHED) {
+#ifdef __ANDROID__
+      status=vm->AttachCurrentThread(&env,nullptr);
+#else
+      status=vm->AttachCurrentThread(reinterpret_cast<void**>(&env),nullptr);
+#endif
+      attached=status==JNI_OK;
+    }
+    if(status==JNI_OK && env) {env->DeleteGlobalRef(reference); --live;}
+    // On JVM shutdown an attach can fail; never call through a null JNIEnv or
+    // claim the reference was released. Normal explicit close runs on a JVM worker.
+    if(attached) vm->DetachCurrentThread();
+  }
+};
+std::atomic<size_t> JavaLease::live{0};
+struct TestControl {
+  std::mutex mutex; std::condition_variable cv; int mode=0; bool entered=false,released=false;
+  void Pause(int point) {
+    std::unique_lock<std::mutex> lock(mutex);
+    if(mode!=point) return;
+    entered=true; cv.notify_all();
+    if(!cv.wait_for(lock,std::chrono::seconds(5),[&]{return released;}))
+      throw std::runtime_error("Lifecycle test barrier timed out");
+  }
+  int Mode() {std::lock_guard<std::mutex> lock(mutex);return mode;}
+};
+struct Entry {
+  std::shared_ptr<JavaLease> artifact;  // Destructs after owner and operation leases.
+  n::Owner owner;
+  n::Identity identity;
+  size_t max_packet=0;
+  std::mutex gate; std::condition_variable idle;
+  bool active=false,closing=false,close_active=false,cancelled=false,failed=false,published=false,closed=false;
+  std::thread::id worker;
+#ifdef NATIVE_OWNER_JNI_TESTING
+  std::shared_ptr<TestControl> test;
+#endif
+};
+std::mutex registry_mutex;
+std::map<jlong,std::shared_ptr<Entry>> registry;
+size_t initializing=0;
+jlong next_handle=1;
+struct Reservation {
+  bool held=false;
+  Reservation() {
+    std::lock_guard<std::mutex> lock(registry_mutex);
+    Require(registry.size()+initializing<kRegistryLimit,"Native owner registry full");
+    Require(next_handle>0 && next_handle<std::numeric_limits<jlong>::max(),"Native handle space exhausted");
