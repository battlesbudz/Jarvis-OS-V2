diff --git a/support/util/projected_audio_payload.cc b/support/util/projected_audio_payload.cc
new file mode 100644
index 0000000..4bf727f
--- /dev/null
+++ b/support/util/projected_audio_payload.cc
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: Apache-2.0
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy at https://www.apache.org/licenses/LICENSE-2.0
+#include "support/util/projected_audio_payload.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <limits>
+
+namespace litert::support {
+
+ProjectedAudioError ValidateSealedProjectedAudio(
+    const SealedProjectedAudioSpec& spec) {
+  if (!spec.complete) return ProjectedAudioError::kNotSealed;
+  if (spec.seal_token.empty() || spec.seal_token.size() > 128 ||
+      !std::all_of(spec.seal_token.begin(), spec.seal_token.end(),
+                   [](unsigned char c) { return c >= 0x21 && c <= 0x7e; })) {
+    return ProjectedAudioError::kInvalidSeal;
+  }
+  if (spec.producer_sha256.size() != 64 ||
+      !std::all_of(spec.producer_sha256.begin(), spec.producer_sha256.end(),
+                   [](unsigned char c) {
+                     return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+                   })) {
+    return ProjectedAudioError::kInvalidProducer;
+  }
+  if (spec.pcm_samples <= 0 || spec.pcm_samples > kProjectedAudioMaxSamples) {
+    return ProjectedAudioError::kInvalidSamples;
+  }
+  const int64_t mel_frames = std::max<int64_t>(1, spec.pcm_samples / 160);
+  const int64_t expected_tokens = (mel_frames + 3) / 4;
+  if (spec.audio_tokens != expected_tokens) {
+    return ProjectedAudioError::kInvalidTokenCount;
+  }
+  if (spec.embedding_width <= 0 ||
+      spec.embedding_width > kProjectedAudioMaxWidth) {
+    return ProjectedAudioError::kInvalidWidth;
+  }
+  return ProjectedAudioError::kOk;
+}
+
+size_t ProjectedAudioByteCount(const SealedProjectedAudioSpec& spec) {
+  return static_cast<size_t>(spec.audio_tokens) *
+         static_cast<size_t>(spec.embedding_width) * sizeof(float);
+}
+
+size_t ProjectedAudioBase64Count(const SealedProjectedAudioSpec& spec) {
+  return ((ProjectedAudioByteCount(spec) + 2) / 3) * 4;
+}
+
+ProjectedAudioError DecodeProjectedAudio(
+    const SealedProjectedAudioSpec& spec, std::string_view bytes,
+    std::vector<float>* output) {
+  static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559);
+  if (output == nullptr) return ProjectedAudioError::kInvalidOutput;
+  output->clear();
+  const auto validation = ValidateSealedProjectedAudio(spec);
+  if (validation != ProjectedAudioError::kOk) return validation;
+  if (bytes.size() != ProjectedAudioByteCount(spec)) {
+    return ProjectedAudioError::kInvalidByteCount;
+  }
+  output->resize(bytes.size() / sizeof(float));
+  const auto* data = reinterpret_cast<const unsigned char*>(bytes.data());
+  for (size_t i = 0; i < output->size(); ++i) {
+    const size_t p = i * sizeof(float);
+    const uint32_t bits = static_cast<uint32_t>(data[p]) |
+                          (static_cast<uint32_t>(data[p + 1]) << 8) |
+                          (static_cast<uint32_t>(data[p + 2]) << 16) |
+                          (static_cast<uint32_t>(data[p + 3]) << 24);
+    std::memcpy(&(*output)[i], &bits, sizeof(float));
+    if (!std::isfinite((*output)[i])) {
+      std::fill(output->begin(), output->end(), 0.0f);
+      output->clear();
+      return ProjectedAudioError::kNonfinite;
+    }
+  }
+  return ProjectedAudioError::kOk;
+}
+
+const char* ProjectedAudioErrorMessage(ProjectedAudioError error) {
+  switch (error) {
+    case ProjectedAudioError::kOk: return "OK";
+    case ProjectedAudioError::kNotSealed: return "Projected audio must be sealed.";
+    case ProjectedAudioError::kInvalidSeal: return "Invalid audio seal token.";
+    case ProjectedAudioError::kInvalidProducer: return "Invalid audio producer hash.";
+    case ProjectedAudioError::kInvalidSamples: return "Invalid complete audio sample count.";
+    case ProjectedAudioError::kInvalidTokenCount: return "Audio token count does not match the complete native PCM input.";
+    case ProjectedAudioError::kInvalidWidth: return "Invalid projected audio width.";
+    case ProjectedAudioError::kInvalidByteCount: return "Projected audio byte count is invalid; EOA must not be included.";
+    case ProjectedAudioError::kInvalidOutput: return "Audio decode output is null.";
+    case ProjectedAudioError::kNonfinite: return "Projected audio contains nonfinite values.";
+  }
+  return "Invalid projected audio.";
+}
+
+}  // namespace litert::support
diff --git a/support/util/projected_audio_payload.h b/support/util/projected_audio_payload.h
new file mode 100644
index 0000000..5fa1108
--- /dev/null
+++ b/support/util/projected_audio_payload.h
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: Apache-2.0
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy at https://www.apache.org/licenses/LICENSE-2.0
+#ifndef THIRD_PARTY_ODML_LITERT_LM_SUPPORT_UTIL_PROJECTED_AUDIO_PAYLOAD_H_
+#define THIRD_PARTY_ODML_LITERT_LM_SUPPORT_UTIL_PROJECTED_AUDIO_PAYLOAD_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace litert::support {
+
+// Caller-provided provenance is retained for application generation/admission
+// checks. It is not a permission grant, speaker identity, or tool authority.
+struct SealedProjectedAudioSpec {
+  int64_t pcm_samples = 0;
+  int64_t audio_tokens = 0;
+  int64_t embedding_width = 0;
+  std::string seal_token;
+  std::string producer_sha256;
+  bool complete = false;
+};
+
+enum class ProjectedAudioError {
+  kOk,
+  kNotSealed,
+  kInvalidSeal,
+  kInvalidProducer,
+  kInvalidSamples,
+  kInvalidTokenCount,
+  kInvalidWidth,
+  kInvalidByteCount,
+  kNonfinite,
+  kInvalidOutput,
+};
+
+constexpr int kProjectedAudioProtocolVersion = 1;
+constexpr int64_t kProjectedAudioMaxSamples = 480000;
+constexpr int64_t kProjectedAudioMaxWidth = 8192;
+
+// The protocol is post-adapter Float32 LE, excludes EOA, and uses the pinned
+// native 16kHz/160-sample-hop frontend. A final InputAudioEnd owns EOA exactly
+// once. Token counts must match the complete native-frontend sample count.
+ProjectedAudioError ValidateSealedProjectedAudio(
+    const SealedProjectedAudioSpec& spec);
+size_t ProjectedAudioByteCount(const SealedProjectedAudioSpec& valid_spec);
+size_t ProjectedAudioBase64Count(const SealedProjectedAudioSpec& valid_spec);
+ProjectedAudioError DecodeProjectedAudio(
+    const SealedProjectedAudioSpec& spec, std::string_view bytes,
+    std::vector<float>* output);
+const char* ProjectedAudioErrorMessage(ProjectedAudioError error);
+
+}  // namespace litert::support
+#endif  // THIRD_PARTY_ODML_LITERT_LM_SUPPORT_UTIL_PROJECTED_AUDIO_PAYLOAD_H_
diff --git a/support/util/projected_audio_payload_contract_test.cc b/support/util/projected_audio_payload_contract_test.cc
new file mode 100644
index 0000000..a3fff87
--- /dev/null
+++ b/support/util/projected_audio_payload_contract_test.cc
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "support/util/projected_audio_payload.h"
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using namespace litert::support;
+int main() {
+  int checks = 0;
+  auto check = [&](bool value) {
+    ++checks;
+    if (!value) throw std::runtime_error("projected audio contract failed");
+  };
+  SealedProjectedAudioSpec base{160, 1, 2, "capture-1", std::string(64, 'a'), true};
+  check(ValidateSealedProjectedAudio(base) == ProjectedAudioError::kOk);
+  check(ProjectedAudioByteCount(base) == 8);
+  check(ProjectedAudioBase64Count(base) == 12);
+  const std::string data("\x00\x00\x00\x3f\x00\x00\x00\x80", 8);
+  std::vector<float> values;
+  check(DecodeProjectedAudio(base, data, nullptr) == ProjectedAudioError::kInvalidOutput);
+  check(DecodeProjectedAudio(base, data, &values) == ProjectedAudioError::kOk);
+  check(values.size() == 2 && values[0] == 0.5f && std::signbit(values[1]));
+  auto invalid = base;
+  invalid.complete = false;
+  check(ValidateSealedProjectedAudio(invalid) == ProjectedAudioError::kNotSealed);
+  invalid = base; invalid.seal_token.clear();
+  check(ValidateSealedProjectedAudio(invalid) == ProjectedAudioError::kInvalidSeal);
+  invalid = base; invalid.seal_token = "capture\n1";
+  check(ValidateSealedProjectedAudio(invalid) == ProjectedAudioError::kInvalidSeal);
+  invalid = base; invalid.producer_sha256[0] = 'z';
+  check(ValidateSealedProjectedAudio(invalid) == ProjectedAudioError::kInvalidProducer);
+  for (int64_t n : std::vector<int64_t>{0LL, -1LL, 480001LL, std::numeric_limits<int64_t>::max()}) {
+    invalid = base; invalid.pcm_samples = n;
+    check(ValidateSealedProjectedAudio(invalid) == ProjectedAudioError::kInvalidSamples);
+  }
+  invalid = base; invalid.audio_tokens = 2;
+  check(ValidateSealedProjectedAudio(invalid) == ProjectedAudioError::kInvalidTokenCount);
+  for (int64_t n : std::vector<int64_t>{0LL, -1LL, 8193LL, std::numeric_limits<int64_t>::max()}) {
+    invalid = base; invalid.embedding_width = n;
+    check(ValidateSealedProjectedAudio(invalid) == ProjectedAudioError::kInvalidWidth);
+  }
+  check(DecodeProjectedAudio(base, data + data, &values) == ProjectedAudioError::kInvalidByteCount);
+  check(values.empty());  // An accidental extra EOA row is never accepted.
+  check(DecodeProjectedAudio(base, data.substr(0, 7), &values) == ProjectedAudioError::kInvalidByteCount);
+  const std::string infinity("\x00\x00\x80\x7f\x00\x00\x00\x00", 8);
+  check(DecodeProjectedAudio(base, infinity, &values) == ProjectedAudioError::kNonfinite);
+  check(values.empty());
+  const std::string nan("\x01\x00\xc0\x7f\x00\x00\x00\x00", 8);
+  check(DecodeProjectedAudio(base, nan, &values) == ProjectedAudioError::kNonfinite);
+  for (int64_t samples : {1LL, 159LL, 160LL, 161LL, 639LL, 640LL, 641LL,
+                          799LL, 800LL, 801LL, 49221LL, 130560LL, 480000LL}) {
+    auto spec = base;
+    spec.pcm_samples = samples;
+    spec.audio_tokens = (std::max<int64_t>(1, samples / 160) + 3) / 4;
+    check(ValidateSealedProjectedAudio(spec) == ProjectedAudioError::kOk);
+  }
+  std::cout << "{\"checks\":" << checks << ",\"all_passed\":true}" << std::endl;
+}
