+    if (callback_ == nullptr && fallback_error_ == nullptr) return;
+    bool attached = false;
+    JNIEnv* env = GetJniEnvAndAttach(jvm_, &attached);
+    if (env) {
+      if (callback_ != nullptr) env->DeleteGlobalRef(callback_);
+      if (fallback_error_ != nullptr) env->DeleteGlobalRef(fallback_error_);
+      if (attached && jvm_->DetachCurrentThread() != JNI_OK) {
+        ABSL_LOG(ERROR) << "Failed to detach while releasing callback owner.";
+      }
+    } else {
+      ABSL_LOG(ERROR) << "Cannot attach JVM to release callback reference.";
+    }
+  }
+
+  jobject Enter(bool terminal_event) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (terminal_ || callback_ == nullptr) return nullptr;
+    ++active_callbacks_;
+    terminal_ = terminal_event;
+    return callback_;
+  }
+
+  void Leave(JNIEnv* env) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    --active_callbacks_;
+    CleanupLocked(env);
+  }
+
+  void Terminate(JNIEnv* env) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    terminal_ = true;
+    CleanupLocked(env);
+  }
+
+  // Claim only immediately before invoking Java onError, not before allocation.
+  bool ClaimErrorDelivery() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    terminal_ = true;
+    if (error_reported_) return false;
+    error_reported_ = true;
+    return true;
+  }
+
+  jstring fallback_error() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return fallback_error_;
+  }
+
+ private:
+  void CleanupLocked(JNIEnv* env) {
+    if (env && terminal_ && active_callbacks_ == 0 && callback_ != nullptr) {
+      env->DeleteGlobalRef(callback_);
+      env->DeleteGlobalRef(fallback_error_);
+      callback_ = nullptr;
+      fallback_error_ = nullptr;
+    }
+  }
+
+  JavaVM* const jvm_;
+  jobject callback_;
+  jstring fallback_error_;
+  std::mutex mutex_;
+  int active_callbacks_ = 0;
+  bool terminal_ = false;
+  bool error_reported_ = false;
+};
