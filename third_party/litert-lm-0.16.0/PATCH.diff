+#include "pinned_native_backend.h"
+
+#include <algorithm>
+#include <cmath>
+#include <map>
+#include <stdexcept>
+#include <utility>
+
+#include "absl/types/span.h"
+#include "litert/cc/litert_api_types.h"
+#include "litert/cc/litert_common.h"
+#include "litert/cc/litert_compiled_model.h"
+#include "litert/cc/litert_element_type.h"
+#include "litert/cc/litert_environment.h"
+#include "litert/cc/litert_expected.h"
+#include "litert/cc/litert_options.h"
+#include "litert/cc/litert_tensor_buffer.h"
+#include "support/preprocessor/audio_preprocessor.h"
+#include "support/preprocessor/audio_preprocessor_miniaudio.h"
+#include "support/util/io_types.h"
+
+namespace native_audio {
+namespace {
+constexpr size_t kLayers = 12, kHistory = 24, kLayerWidth = 1024;
+constexpr size_t kLayerFloats = kHistory * kLayerWidth;
+constexpr char kSdkPin[] = "924e79c91542761242244e4f1651851f822e4cbb";
+constexpr char kLiteRtPin[] = "0ff28117f1cb5556d0e015bf80b773f74e2bee51";
+constexpr char kExpectedModel[] = "d5c50b140ace235717e6713d287e73ccfa4f32d0090e1cceb9d00714da850a1b";
+void Require(bool valid, const char* message) {
+  if (!valid) throw std::runtime_error(message);
+}
+template <typename T> T Take(litert::Expected<T> result) {
+  if (!result) throw std::runtime_error(result.Error().Message());
+  return std::move(*result);
+}
+void Check(litert::Expected<void> result) {
+  if (!result) throw std::runtime_error(result.Error().Message());
+}
+std::string Layer(const char* prefix, size_t i) {
+  return std::string(prefix) + (i < 10 ? "0" : "") + std::to_string(i);
+}
+struct Spec { litert::ElementType type; std::vector<int32_t> dims; size_t bytes; };
+using Specs = std::map<std::string, Spec>;
+using Names = std::map<std::string, size_t>;
+Specs InputSpecs() {
+  using E = litert::ElementType;
+  Specs specs{{"mel", {E::Float32, {1,48,128}, 48*128*4}},
+              {"valid_mel_frames", {E::Int32, {1}, 4}},
+              {"history_tokens", {E::Int32, {1}, 4}},
+              {"prev_mel", {E::Float32, {1,4,128}, 4*128*4}}};
+  for (size_t i=0;i<kLayers;++i)
+    specs.emplace(Layer("prev_layer_", i), Spec{E::Float32, {1,24,1024}, kLayerFloats*4});
+  return specs;
+}
+Specs OutputSpecs() {
+  using E = litert::ElementType;
+  Specs specs{{"soft_tokens", {E::Float32, {1,12,1536},12*1536*4}},
+              {"encoder_features", {E::Float32, {1,12,1536},12*1536*4}},
+              {"token_mask", {E::Bool, {1,12},12}},
+              {"token_count", {E::Int32, {1},4}},
+              {"next_history_tokens", {E::Int32, {1},4}},
+              {"next_mel", {E::Float32, {1,4,128},4*128*4}}};
+  for (size_t i=0;i<kLayers;++i)
+    specs.emplace(Layer("next_layer_", i), Spec{E::Float32, {1,24,1024},kLayerFloats*4});
+  return specs;
+}
+void Validate(litert::TensorBuffer& buffer, const Spec& spec) {
+  auto type = Take(buffer.TensorType());
+  auto dims = type.Layout().Dimensions();
+  Require(type.ElementType() == spec.type && dims.size() == spec.dims.size() &&
+    std::equal(dims.begin(),dims.end(),spec.dims.begin()) &&
+    Take(buffer.PackedSize()) == spec.bytes, "native tensor contract mismatch");
+}
+Names Bind(const std::vector<litert::StringView>& runtime_names,
+           std::vector<litert::TensorBuffer>& buffers, const Specs& specs) {
+  Require(runtime_names.size()==specs.size() && buffers.size()==specs.size(),
+          "native signature tensor count mismatch");
+  Names names;
+  for (size_t i=0;i<runtime_names.size();++i) {
+    std::string name(runtime_names[i]);
+    auto found = specs.find(name);
+    Require(found != specs.end() && names.emplace(name,i).second,
+            "unknown/duplicate runtime tensor name");
+    Validate(buffers[i], found->second);
+  }
+  return names;  // Runtime order, NEVER FlatBuffer SignatureDef map order.
+}
+litert::CompiledModel MakeModel(litert::Environment& environment, const std::string& path) {
+  auto options = Take(litert::Options::Create());
+  Check(options.SetHardwareAccelerators(litert::HwAccelerators::kCpu));
+  auto cpu = options.GetCpuOptions();
+  Require(cpu.HasValue(), "CPU options unavailable");
+  Check(cpu->SetNumThreads(2));
+  return Take(litert::CompiledModel::Create(environment, path, options));
+}
+std::unique_ptr<litert::support::AudioPreprocessorMiniAudio> MakeFrontend() {
+  using C = litert::support::AudioPreprocessorConfig;
+  auto config = C::Create(16000,1,320,160,512,1.0f,0.0f,128,0.0f,8000.0f,
+      0.001f,false,true,true,false,true,C::kCenter,false,false);
+  auto result = litert::support::AudioPreprocessorMiniAudio::Create(config);
+  Require(result.ok(), "native frontend initialization failed");
+  return std::move(result).value();
+}
+class PinnedBackend final : public Backend {
+ public:
+  PinnedBackend(const std::string& path, std::shared_ptr<const void> lease)
+      : artifact_lease_(std::move(lease)), environment_(Take(litert::Environment::Create({}))),
+        model_(MakeModel(environment_,path)), frontend_(MakeFrontend()),
+        state_(kLayers*kLayerFloats,0.0f) {
+    signature_ = Take(model_.GetSignatureIndex("audio_stream_step"));
+    inputs_ = Take(model_.CreateInputBuffers(signature_));
+    outputs_ = Take(model_.CreateOutputBuffers(signature_));
+    input_names_ = Bind(Take(model_.GetSignatureInputNames(signature_)), inputs_, InputSpecs());
+    output_names_ = Bind(Take(model_.GetSignatureOutputNames(signature_)), outputs_, OutputSpecs());
+  }
+  ~PinnedBackend() override {
+    prev_mel_.fill(0);
+    std::fill(state_.begin(),state_.end(),0.0f);
+    // TensorBuffers, frontend, model, environment then artifact lease destruct
+    // in the reverse of their declaration order. Delegate erasure not promised.
+  }
+  Producer producer() const override {
+    return {"pinned-cpp-gemma4-e2b-stateful-owner-v1", kSdkPin, kLiteRtPin, kExpectedModel, 0};
+  }
+  Status Frontend(const float* pcm, size_t samples,
+                  std::array<float,kMelWidth>* mel) override {
+    try {
+      Require(pcm && mel && samples>=1 && samples<=kHop, "invalid frontend hop");
+      std::vector<float> packet(pcm,pcm+samples);
+      litert::support::InputAudio input(std::move(packet));
+      auto result = frontend_->Preprocess(input);  // Official public SDK method.
+      Require(result.ok(), "native frontend failed after input consumption");
+      auto tensor = result->GetPreprocessedAudioTensor();
+      Require(tensor.ok(), "native frontend omitted Mel tensor");
+      // Public const TensorBuffer view uses its official scoped read lock.
+      auto type = Take((*tensor)->TensorType());
+      auto dims = type.Layout().Dimensions();
+      Require(type.ElementType()==litert::ElementType::Float32 && dims.size()==3 &&
+              dims[0]==1 && dims[1]==1 && dims[2]==128 &&
+              Take((*tensor)->PackedSize())==kMelWidth*sizeof(float), "invalid Mel tensor");
+      auto locked = Take(litert::TensorBufferScopedLock::Create<float>(
+          **tensor, litert::TensorBuffer::LockMode::kRead));
+      std::copy_n(locked.second, mel->size(), mel->begin());
+      return Status::Ok();
+    } catch (...) { return {Code::kNativeFailure,"pinned frontend failed"}; }
+  }
+  Status Step(const std::array<float,kStepFrames*kMelWidth>& mel,
+              size_t frames, bool final, StepRows* rows) override {
+    try {
+      Require(rows && frames>=1 && frames<=48 && (final || frames%4==0), "invalid step schedule");
+      Require(!ended_ && history_>=0 && history_<=24, "invalid native cache lifecycle");
+      const int32_t valid=static_cast<int32_t>(frames);
+      Write("mel",mel.data(),mel.size());
+      Write("valid_mel_frames",&valid,1); Write("history_tokens",&history_,1);
+      Write("prev_mel",prev_mel_.data(),prev_mel_.size());
+      for(size_t i=0;i<kLayers;++i)
+        Write(Layer("prev_layer_",i),state_.data()+i*kLayerFloats,kLayerFloats);
+      Check(model_.Run(signature_,inputs_,outputs_));
+      int32_t count=0, next_history=0;
+      Read("token_count",&count,1); Read("next_history_tokens",&next_history,1);
+      Require(count==static_cast<int32_t>((frames+3)/4) &&
+              next_history==std::min(24,history_+count), "invalid native row/history count");
+      std::array<uint8_t,kStepTokens> mask{};
+      Read("token_mask",mask.data(),mask.size());
+      for(size_t i=0;i<mask.size();++i)
+        Require(mask[i]==static_cast<uint8_t>(i<static_cast<size_t>(count)), "invalid native token mask");
+      StepRows candidate;
+      candidate.count=static_cast<size_t>(count);
+      Read("soft_tokens",candidate.values.data(),candidate.values.size());
+      Require(Finite(candidate.values.data(),candidate.count*kEmbeddingWidth), "non-finite native rows");
+      std::array<float,4*kMelWidth> next_mel{};
+      std::vector<float> next_state(kLayers*kLayerFloats);
+      Read("next_mel",next_mel.data(),next_mel.size());
+      Require(Finite(next_mel.data(),next_mel.size()), "non-finite native Mel cache");
+      for(size_t i=0;i<kLayers;++i) {
+        auto* next=next_state.data()+i*kLayerFloats;
+        Read(Layer("next_layer_",i),next,kLayerFloats);
+        Require(Finite(next,kLayerFloats), "non-finite native layer cache");
+        Require(std::all_of(next+next_history*kLayerWidth,next+kLayerFloats,
+                    [](float x){return x==0.0f;}), "noncanonical native history suffix");
+      }
+      // Only commit cache replacements after all output contracts validate.
+      history_=next_history; prev_mel_=next_mel; state_.swap(next_state);
+      std::fill(next_state.begin(),next_state.end(),0.0f);
+      ended_=final;
+      *rows=std::move(candidate);
+      return Status::Ok();
+    } catch (...) { return {Code::kNativeFailure,"pinned CompiledModel step failed"}; }
+  }
+ private:
+  static bool Finite(const float* values,size_t count) {
+    return std::all_of(values,values+count,[](float x){return std::isfinite(x);});
+  }
+  template<typename T> void Write(const std::string& name,const T* values,size_t count) {
+    Check(inputs_.at(input_names_.at(name)).Write<T>(litert::Span<const T>(values,count)));
+  }
+  template<typename T> void Read(const std::string& name,T* values,size_t count) {
+    Check(outputs_.at(output_names_.at(name)).Read<T>(litert::Span<T>(values,count)));
+  }
+  // This order ensures buffers die before model, and model before environment.
+  std::shared_ptr<const void> artifact_lease_;
+  litert::Environment environment_;
+  litert::CompiledModel model_;
+  std::unique_ptr<litert::support::AudioPreprocessorMiniAudio> frontend_;
+  size_t signature_=0;
+  std::vector<litert::TensorBuffer> inputs_, outputs_;
+  Names input_names_, output_names_;
+  int32_t history_=0;
+  bool ended_=false;
+  std::array<float,4*kMelWidth> prev_mel_{};
+  std::vector<float> state_;
+};
+}
+Status CreatePinnedBackend(const std::string& path,std::shared_ptr<const void> lease,
+                           std::unique_ptr<Backend>* out) {
+  if(!out || path.empty() || !lease) return {Code::kInvalid,"immutable artifact path and live lease required"};
+  try {
+    auto backend=std::make_unique<PinnedBackend>(path,std::move(lease));
+    *out=std::move(backend);
+    return Status::Ok();
+  } catch(...) { return {Code::kNativeFailure,"pinned backend initialization failed"}; }
+}
+}  // namespace native_audio
